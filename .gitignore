# Example .gitignore file for your config dir.
# A * ensures that everything will be ignored.
*

# You can allowlist files/folders with !, these will not be ignored.
!*.yaml
!.gitignore
!*.md
# Alleen eigen blueprints; HA zet er zelf ook stock- en community-blueprints
# neer en die horen niet in git. Elke tussenliggende map moet apart in de
# allowlist, anders daalt git de genegeerde map niet in (zelfde valkuil als
# bij www/icons).
!blueprints/
!blueprints/automation/
!blueprints/automation/robin/
!blueprints/automation/robin/**
!dashboards/
!dashboards/*
!dashboards/**
!includes/
!includes/*
!packages/
!packages/**
# Jinja-macro's (klimaatregie) horen bij de config, en .jinja valt niet onder
# de allowlist hierboven.
!custom_templates/
!custom_templates/**
!docs/
!docs/**
!tests/
!tests/**
!themes/
!themes/*
# Git daalt een genegeerde map niet in, dus elke tussenliggende map moet
# apart in de allowlist. `!www/icons/*` alleen deed daardoor niets: www/
# zelf bleef genegeerd en de iconen kwamen nooit in de repo.
!www/
!www/icons/
!www/icons/**

# Ignore folders
.cloud
.storage
.vscode

# Ensure these files are ignored, otherwise your secret data/credentials will leak.
ip_bans.yaml
secrets.yaml
known_devices.yaml
googleassistant_serviceaccount.json
includes/googleassistant_serviceaccount.json
.google.token
.spotify-token-cache
.sonoff.json

# Ignore Python cache files 
__pycache__/
{#-
==============================================================================
  KAMERSTATUS - hoe staat het ervoor in elke ruimte
==============================================================================

  Dit bestand is de enige plek waar staat WANNEER een kamer goed is. De sensor
  in `packages/9 - Other/Kamers.yaml` doet alleen het meten en het uitserveren;
  `dashboards/home/kamers.yaml` tekent alleen wat hier uit komt.

  Gebruik:

      {% from 'kamers.jinja' import kamers_json %}
      {{ (kamers_json() | trim | from_json).kamers }}

  LET OP: wijzigingen in dit bestand vragen een volledige herstart van Home
  Assistant (custom_templates worden alleen bij het opstarten ingelezen).

  ---------------------------------------------------------------------------
  CONTROLEER DIT EERST: de area-namen in de tabel hieronder
  ---------------------------------------------------------------------------
  De metingen worden niet met de hand gekoppeld maar opgehaald met
  `area_entities()`, gefilterd op device_class. Dat betekent dat een nieuwe
  sensor vanzelf in het overzicht verschijnt zodra hij in de juiste area zit -
  maar ook dat een kamer leeg blijft als de area anders heet dan hier staat.
  Blijft een tegel op "geen meting" staan terwijl er wel sensoren hangen, kijk
  dan eerst naar `area` en pas daarna naar de rest.

  Per kamer kun je bijsturen zonder de automatiek te verlaten:
    klimaat   ÉÉN entiteit van het apparaat dat deze kamer echt meet, meestal
              de thermometer. Alles wat verder aan datzelfde apparaat hangt
              (luchtvochtigheid, en bij de woonkamer-multisensor ook CO2,
              fijnstof en lux) wordt via `device_entities()` automatisch
              meegenomen en gaat vóór de rest van de ruimte. Dit is het veld dat
              je in de praktijk invult - zie NEGEER_PATRONEN verderop voor
              waarom het nodig is.
    voorkeur  losse entiteiten die zelfs vóór `klimaat` gaan. Alleen nodig als
              één kamer twee apparaten heeft en je per meetwaarde wil kiezen.
    extra     entiteiten die buiten de area vallen maar er wel bij horen.
    negeer    entiteiten die in de area zitten maar niet meetellen.

  Ontbreekt `klimaat` bij een kamer, dan staat daar (voor zover bekend) geen
  eigen thermometer en valt de tegel terug op wat de area oplevert. Dat is
  bewust: liever een streepje dan het cijfer van een willekeurig apparaat.

  Waarom niet gewoon een vaste tabel met entity-ids, zoals ZONES in
  klimaat.jinja? Omdat die tabel over ACTIES gaat (welke cover stuur ik aan) en
  deze over WAARNEMINGEN. Bij een actie is een expliciete koppeling precies wat
  je wil; bij een waarneming is elke sensor die je vergeet toe te voegen een
  gat dat je niet ziet - en dit overzicht bestaat juist om gaten te tonen.
-#}

{#- ========================== DE KAMERS ==================================== -#}
{#-
  slug        sleutel voor het dashboard, moet uniek zijn
  naam        label op de tegel
  icoon       mdi-icoon
  verdieping  kop waaronder de tegel valt (bepaalt de kolom op het dashboard)
  area        naam of id van de area in Home Assistant
  soort       leef | slaap | nat | techniek | buiten, bepaalt de comfortgrenzen
  klimaat     één entiteit van het apparaat dat de kamer meet (optioneel)
-#}
{%- set KAMERS = [
      {'slug': 'woonkamer', 'naam': 'Woonkamer', 'icoon': 'mdi:sofa-outline',
       'verdieping': 'Begane grond', 'area': 'Woonkamer', 'soort': 'leef',
       'klimaat': 'sensor.woonkamer_woonkamer_multisensor_temperatuur'},
      {'slug': 'keuken', 'naam': 'Keuken', 'icoon': 'mdi:countertop',
       'verdieping': 'Begane grond', 'area': 'Keuken', 'soort': 'leef'},
      {'slug': 'entree', 'naam': 'Entree', 'icoon': 'mdi:coat-rack',
       'verdieping': 'Begane grond', 'area': 'Entree', 'soort': 'leef'},
      {'slug': 'toilet', 'naam': 'Toilet', 'icoon': 'mdi:toilet',
       'verdieping': 'Begane grond', 'area': 'Toilet', 'soort': 'nat'},
      {'slug': 'speelkamer', 'naam': 'Speelkamer', 'icoon': 'mdi:teddy-bear',
       'verdieping': 'Begane grond', 'area': 'Speelkamer', 'soort': 'leef',
       'klimaat': 'sensor.speelkamer_speelkamer_temperatuur_temperatuur'},
      {'slug': 'garage', 'naam': 'Garage', 'icoon': 'mdi:garage-variant',
       'verdieping': 'Begane grond', 'area': 'Garage', 'soort': 'techniek',
       'klimaat': 'sensor.garage_garage_temperatuur_temperatuur'},
      {'slug': 'meterkast', 'naam': 'Meterkast', 'icoon': 'mdi:flash-outline',
       'verdieping': 'Begane grond', 'area': 'Meterkast', 'soort': 'techniek',
       'klimaat': 'sensor.meterkast_temperatuur_temperature'},

      {'slug': 'slaapkamer', 'naam': 'Slaapkamer', 'icoon': 'mdi:bed-king-outline',
       'verdieping': 'Eerste verdieping', 'area': 'Slaapkamer', 'soort': 'slaap',
       'klimaat': 'sensor.slaapkamer_slaapkamer_temperatuur_temperatuur'},
      {'slug': 'slaapkamer_logan', 'naam': 'Slaapkamer Logan', 'icoon': 'mdi:bed-single-outline',
       'verdieping': 'Eerste verdieping', 'area': 'Slaapkamer Logan', 'soort': 'slaap',
       'klimaat': 'sensor.slaapkamer_logan_slaapkamer_maxi_temperatuur_temperatuur'},
      {'slug': 'badkamer', 'naam': 'Badkamer', 'icoon': 'mdi:shower',
       'verdieping': 'Eerste verdieping', 'area': 'Badkamer', 'soort': 'nat',
       'klimaat': 'sensor.badkamer_badkamer_temperatuur_temperatuur'},
      {'slug': 'kantoor', 'naam': 'Kantoor', 'icoon': 'mdi:desk',
       'verdieping': 'Eerste verdieping', 'area': 'Kantoor', 'soort': 'leef',
       'klimaat': 'sensor.kantoor_kantoor_temperatuur_temperatuur'},
      {'slug': 'overloop', 'naam': 'Overloop', 'icoon': 'mdi:stairs',
       'verdieping': 'Eerste verdieping', 'area': 'Overloop', 'soort': 'leef'},

      {'slug': 'slaapkamer_emma', 'naam': 'Slaapkamer Emma', 'icoon': 'mdi:bed-single-outline',
       'verdieping': 'Tweede verdieping', 'area': 'Slaapkamer Emma', 'soort': 'slaap',
       'klimaat': 'sensor.slaapkamer_emma_slaapkamer_mini_temperatuur_temperatuur'},
      {'slug': 'zolder', 'naam': 'Zolder', 'icoon': 'mdi:home-roof',
       'verdieping': 'Tweede verdieping', 'area': 'Zolder', 'soort': 'techniek'},

      {'slug': 'schuur', 'naam': 'Schuur', 'icoon': 'mdi:home-outline',
       'verdieping': 'Buiten', 'area': 'Schuur', 'soort': 'techniek',
       'klimaat': 'sensor.achtertuin_schuur_temperatuur_temperature'},
      {'slug': 'achtertuin', 'naam': 'Achtertuin', 'icoon': 'mdi:tree-outline',
       'verdieping': 'Buiten', 'area': 'Achtertuin', 'soort': 'buiten'},
      {'slug': 'voortuin', 'naam': 'Voortuin', 'icoon': 'mdi:home-city-outline',
       'verdieping': 'Buiten', 'area': 'Voortuin', 'soort': 'buiten'},
    ] -%}

{#- ======================== WAT METEN WE ================================== -#}
{#- sleutel, device_class, label op de tegel, eenheid, volgorde bij gelijke
    score (lager wint). Lucht gaat vóór comfort: een kamer van 26° is
    vervelend, 1400 ppm CO2 merk je in je hoofd. -#}
{%- set METINGEN = [
      {'k': 'co2',  'dc': 'carbon_dioxide', 'label': 'CO₂',   'eenheid': '', 'prio': 0},
      {'k': 'pm25', 'dc': 'pm25',           'label': 'PM2.5', 'eenheid': '', 'prio': 1},
      {'k': 'temp', 'dc': 'temperature',    'label': 'temp',  'eenheid': '°', 'prio': 2},
      {'k': 'rv',   'dc': 'humidity',       'label': 'RV',    'eenheid': '%', 'prio': 3},
      {'k': 'lux',  'dc': 'illuminance',    'label': 'licht', 'eenheid': '',  'prio': 9},
    ] -%}

{#- ======================== DE GRENZEN ==================================== -#}
{#-
  Elke band is min_slecht / min_ok / max_ok / max_slecht. Daarbuiten is het
  rood, daartussen oranje, ertussenin groen. `none` betekent: aan die kant
  bestaat geen grens (CO2 kan niet te laag zijn).

  Herkomst: CO2 800/1200 ppm is de gangbare binnenluchtnorm (Bouwbesluit-klasse
  B ligt op 950, boven 1200 gaat concentratie meetbaar achteruit). PM2.5 volgt
  de WHO-daggrens van 15 µg/m3, met 10 als 'nog echt goed' en 25 als de oude
  EU-jaargrens. RV 40-60% is het venster waarin huisstofmijt, schimmel en droge
  slijmvliezen elkaar het minst in de weg zitten.

  Lux krijgt bewust geen band: licht is context ("het is er donker"), geen
  kwaliteitsoordeel. Een donkere slaapkamer om 23:00 is precies goed.
-#}
{%- set BASIS = {
      'temp': {'min_slecht': 15, 'min_ok': 18,   'max_ok': 25,  'max_slecht': 28},
      'rv':   {'min_slecht': 25, 'min_ok': 35,   'max_ok': 65,  'max_slecht': 75},
      'co2':  {'min_slecht': none, 'min_ok': none, 'max_ok': 800, 'max_slecht': 1200},
      'pm25': {'min_slecht': none, 'min_ok': none, 'max_ok': 10,  'max_slecht': 25},
      'lux':  none,
    } -%}

{#- Alleen de afwijkingen per soort ruimte. Een slaapkamer mag kouder zijn, een
    badkamer natter, en in een garage of meterkast gaat het niet om comfort maar
    om vorst en condens. Buiten meten we wel, maar beoordelen we niets. -#}
{%- set AFWIJKEND = {
      'slaap': {
        'temp': {'min_slecht': 13, 'min_ok': 15, 'max_ok': 21, 'max_slecht': 24} },
      'nat': {
        'temp': {'min_slecht': 14, 'min_ok': 17, 'max_ok': 26, 'max_slecht': 30},
        'rv':   {'min_slecht': 25, 'min_ok': 35, 'max_ok': 75, 'max_slecht': 85} },
      'techniek': {
        'temp': {'min_slecht': 2, 'min_ok': 5, 'max_ok': 30, 'max_slecht': 38},
        'rv':   {'min_slecht': none, 'min_ok': none, 'max_ok': 70, 'max_slecht': 80},
        'co2':  none,
        'pm25': none },
      'buiten': {
        'temp': none, 'rv': none, 'co2': none, 'pm25': none },
    } -%}

{#- ==================== WAT GEEN KAMERMETING IS ========================== -#}
{#-
  Een device_class alleen is niet genoeg om te weten of een sensor de RUIMTE
  meet of ZICHZELF. Op 3 augustus 2026 stond hierdoor het halve huis op 27 tot
  40 graden terwijl het buiten 22 was: zigbee2mqtt geeft vrijwel elk apparaat
  een `device_temperature` (de printplaat) met `device_class: temperature`, en
  die won van de echte thermometer omdat de volgorde uit de registry
  willekeurig is. Het verraad zat in de cijfers: elke tegel stond op een rond
  getal, want die printplaattemperatuur is een integer.

  Alles wat hieronder in een entity-id voorkomt telt daarom niet mee als
  kamermeting. Twee soorten:
    - apparaten die hun eigen temperatuur melden (printplaat, chip, omvormer)
    - apparaten die iets ánders dan de kamer meten (koelkast, aquarium,
      espressomachine, jacuzzi)

  Dit is dezelfde soort uitsluiting als bij de veelgebruikers op Overzicht
  (filteren op naam, niet op device_class) en bij de batterijkaart. Staat er
  straks een tegel op een raar getal, dan is dit de lijst die je uitbreidt.

  Let op de volgorde in het geheel: `voorkeur` per kamer gaat hier nog vóór.
  Weet je welke sensor het moet zijn, zet hem dan daar neer - dan maakt deze
  lijst niet meer uit.
-#}
{%- set NEGEER_PATRONEN = [
      'apparaattemperatuur', 'apparaat_temperatuur', 'device_temperature',
      'internal_temp', 'cpu', 'chip', 'board', 'processor',
      'omvormer', 'inverter', 'thuisbatterij', 'accu', 'marstek', 'goodwe',
      'sems', 'laadpaal', 'zonnepane',
      'koelkast', 'vriezer', 'diepvries', 'oven', 'vaatwasser', 'wasmachine',
      'droger', 'aquarium', 'jacuzzi', 'purespa', 'boiler',
      'linea', 'micra', 'espresso', 'koffie',
      'knmi', 'dauwpunt', 'gevoelstemperatuur', 'forecast',
    ] -%}

{#- Binaire sensoren worden op device_class herkend, met de naamgeving van dit
    huis als vangnet: zigbee2mqtt levert `_occupancy` en `_contact` en niet elke
    integratie zet een device_class. -#}
{%- set DC_BEWEGING = ['motion', 'occupancy', 'presence'] -%}
{%- set DC_CONTACT = ['door', 'window', 'opening', 'garage_door'] -%}

{#- ============================== HELPERS ================================= -#}

{#- Staat deze entiteit op de uitsluitlijst? Geeft '1' of leeg terug. -#}
{%- macro _verdacht(e) -%}
{%- set ns = namespace(v='') -%}
{%- for p in NEGEER_PATRONEN if p in e -%}{%- set ns.v = '1' -%}{%- endfor -%}
{{- ns.v -}}
{%- endmacro -%}

{#- Eerste bruikbare meting uit een lijst kandidaten. `unavailable` telt niet
    als meting maar ook niet als storing: de volgende kandidaat mag het
    overnemen. Zo valt een kamer met twee thermometers niet uit als er één
    batterij leeg is. -#}
{%- macro _meting(kandidaten, dc) -%}
{%- set ns = namespace(id='', w=none) -%}
{%- for e in kandidaten if ns.w is none -%}
  {%- if e[:7] == 'sensor.' and state_attr(e, 'device_class') == dc -%}
    {%- set w = states(e) | float(none) -%}
    {%- if w is not none -%}{%- set ns.id = e -%}{%- set ns.w = w -%}{%- endif -%}
  {%- elif e[:8] == 'climate.' and dc == 'temperature' -%}
    {%- set w = state_attr(e, 'current_temperature') | float(none) -%}
    {%- if w is not none -%}{%- set ns.id = e -%}{%- set ns.w = w -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{{- {'id': ns.id, 'w': ns.w} | to_json -}}
{%- endmacro -%}

{#- 0 goed, 1 let op, 2 slecht, -1 niet gemeten of niet beoordeeld. -#}
{%- macro _score(w, b) -%}
{%- if w is none or b is none -%}-1
{%- elif b.min_slecht is not none and w < b.min_slecht -%}2
{%- elif b.max_slecht is not none and w > b.max_slecht -%}2
{%- elif b.min_ok is not none and w < b.min_ok -%}1
{%- elif b.max_ok is not none and w > b.max_ok -%}1
{%- else -%}0
{%- endif -%}
{%- endmacro -%}

{#- ========================= HET OVERZICHT ================================ -#}
{#-
  Geeft JSON terug: {'kamers': [ ... ]} met per kamer

    slug, naam, icoon, verdieping, soort
    status     goed | let op | slecht | geen meting
    score      0 | 1 | 2 | -1
    reden      wat er aan de hand is, of wat er goed gaat
    advies     wat je eraan kunt doen (leeg als er niets te doen is)
    metingen   lijst met {k, label, w, eenheid, score, id, oud}
    beweging   {gemeten, actief, minuten}
    contacten  {gemeten, open, totaal, namen}
-#}
{%- macro kamers_json() -%}
{%- set buiten = states('sensor.knmi_temperatuur') | float(none) -%}
{#- Leeftijden zijn na een herstart allemaal even oud, dus dan zegt "al 3 uur
    niets gehoord" niets. Pas als HA zelf lang genoeg draait mag een meting
    'oud' heten. Zelfde redenering als de tijdlijn op het overzicht. -#}
{%- set gestart = states('sensor.home_assistant_gestart') | as_datetime -%}
{%- set mag_verouderen = gestart is not none
                         and (now() - gestart).total_seconds() > 7200 -%}
{%- set uit = namespace(lijst=[]) -%}

{%- for k in KAMERS -%}
  {%- set soort = k.soort -%}
  {%- set negeer = k.get('negeer', []) -%}

  {#- Kandidaten ophalen, in volgorde van vertrouwen:
        1. voorkeur  met de hand aangewezen, wint altijd
        2. klimaat    álles van het klimaatapparaat van deze kamer
        3. area      de rest van de ruimte
        4. climate   een airco kent zijn kamertemperatuur, bij gebrek aan beter

      Stap 2 is de belangrijkste. Een slaapkamer heeft hier vijf sensoren met
      device_class temperature, waarvan er vier de printplaat van een deur- of
      raamcontact meten. Maar ze horen bij verschillende APPARATEN, en er is er
      precies één dat de kamer meet. Door dat ene apparaat aan te wijzen en
      `device_entities()` te laten uitzoeken wat er verder aan hangt, koppel je
      per kamer één entiteit in plaats van één per meetwaarde - de
      luchtvochtigheid van dezelfde melder komt vanzelf mee, en bij de
      woonkamer-multisensor ook CO2, fijnstof en lux.
      De uitsluitlijst geldt hier óók: een thermometer die daarnaast zijn eigen
      printplaattemperatuur meldt, zou anders alsnog zichzelf kunnen kiezen. -#}
  {%- set c = namespace(klim=[], sens=[], clim=[], bin=[]) -%}
  {%- set bron = k.get('klimaat') -%}
  {%- set bron_dev = device_id(bron) if bron else none -%}
  {%- set bron_ids = device_entities(bron_dev) if bron_dev
                     else ([bron] if bron else []) -%}
  {%- for e in bron_ids if e[:7] == 'sensor.' and e not in negeer -%}
    {%- if _verdacht(e) | trim == '' -%}{%- set c.klim = c.klim + [e] -%}{%- endif -%}
  {%- endfor -%}

  {%- for e in area_entities(k.area) if e not in negeer -%}
    {#- De uitsluitlijst geldt alleen voor meetsensoren. Binaire sensoren gaan
        er buiten om: een deurcontact op de koelkast is nog steeds een
        deurcontact. -#}
    {%- if e[:7] == 'sensor.' -%}
      {%- if _verdacht(e) | trim == '' -%}{%- set c.sens = c.sens + [e] -%}{%- endif -%}
    {%- elif e[:8] == 'climate.' -%}{%- set c.clim = c.clim + [e] -%}
    {%- elif e[:14] == 'binary_sensor.' -%}{%- set c.bin = c.bin + [e] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set kandidaten = k.get('voorkeur', []) + c.klim + c.sens
                       + k.get('extra', []) + c.clim -%}

  {#- --- de meetwaarden --- -#}
  {%- set m = namespace(lijst=[], ergst=-1, prio=99, ergste_k='', ergste_w=none,
                        aantal=0, labels=[]) -%}
  {%- for meting in METINGEN -%}
    {%- set v = _meting(kandidaten, meting.dc) | trim | from_json -%}
    {%- set band = AFWIJKEND.get(soort, {}).get(meting.k, BASIS[meting.k]) -%}
    {%- set score = _score(v.w, band) | int -%}
    {#- Een sensor die uren stil staat is geen meting meer maar een aanname.
        Hij blijft staan (met een merkteken), want een leeg vakje zou suggereren
        dat er geen sensor hángt - en dat is een heel ander probleem. -#}
    {%- set oud = mag_verouderen and v.id != ''
                  and (now() - states[v.id].last_updated).total_seconds() > 7200 -%}
    {%- if v.w is not none -%}
      {%- set m.aantal = m.aantal + 1 -%}
      {%- set m.labels = m.labels + [meting.label | lower] -%}
    {%- endif -%}
    {%- if score > m.ergst or (score == m.ergst and meting.prio < m.prio and score > 0) -%}
      {%- if score > 0 -%}
        {%- set m.ergst = score -%}{%- set m.prio = meting.prio -%}
        {%- set m.ergste_k = meting.k -%}{%- set m.ergste_w = v.w -%}
      {%- elif m.ergst < 0 -%}
        {%- set m.ergst = score -%}
      {%- endif -%}
    {%- endif -%}
    {%- set m.lijst = m.lijst + [{'k': meting.k, 'label': meting.label,
                                  'w': v.w, 'eenheid': meting.eenheid,
                                  'score': score, 'id': v.id, 'oud': oud}] -%}
  {%- endfor -%}

  {#- --- beweging --- -#}
  {%- set bw = namespace(aantal=0, actief=false, jongste=none) -%}
  {%- for e in c.bin -%}
    {%- set dc = state_attr(e, 'device_class') -%}
    {%- if dc in DC_BEWEGING or 'beweging' in e or e.endswith('_occupancy') -%}
      {%- set bw.aantal = bw.aantal + 1 -%}
      {%- if is_state(e, 'on') -%}{%- set bw.actief = true -%}{%- endif -%}
      {%- set leeftijd = (now() - states[e].last_changed).total_seconds() / 60 -%}
      {%- if bw.jongste is none or leeftijd < bw.jongste -%}
        {%- set bw.jongste = leeftijd -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {#- --- ramen en deuren --- -#}
  {%- set ct = namespace(totaal=0, open=0, namen=[]) -%}
  {%- for e in c.bin -%}
    {%- set dc = state_attr(e, 'device_class') -%}
    {%- if dc in DC_CONTACT or e.endswith('_contact') -%}
      {%- set ct.totaal = ct.totaal + 1 -%}
      {%- if is_state(e, 'on') -%}
        {%- set ct.open = ct.open + 1 -%}
        {%- set ct.namen = ct.namen + [state_attr(e, 'friendly_name') or e] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {#- --- oordeel --- -#}
  {%- set status = {2: 'slecht', 1: 'let op', 0: 'goed'}.get(m.ergst, 'geen meting') -%}
  {%- set w = m.ergste_w -%}
  {%- set g = (w | round(1) | string | replace('.0', '') | replace('.', ',')) if w is not none else '?' -%}

  {%- set ns = namespace(reden='', advies='') -%}
  {%- if m.ergst < 0 -%}
    {#- Niet beoordeeld is niet hetzelfde als niet gemeten. Buiten meten we wel
        maar oordelen we niet, en een ruimte waar alleen een lichtsensor hangt
        heeft ook geen oordeel - maar wel een sensor. Die twee door elkaar halen
        zou het overzicht juist blind maken voor echte gaten. -#}
    {%- if m.aantal == 0 -%}
      {%- set ns.reden = 'geen sensoren in deze ruimte' -%}
    {%- elif soort == 'buiten' -%}
      {%- set ns.reden = 'buitenwaarden, niet beoordeeld' -%}
    {%- else -%}
      {#- Wél sensoren, maar niets dat een oordeel oplevert - meestal een
          ruimte met alleen een lichtsensor in een bewegingsmelder. Noem op wat
          er dan wél is, anders lijkt het op een storing. -#}
      {%- set ns.reden = 'alleen ' ~ (m.labels | join(' en ')) ~ ', geen thermometer' -%}
    {%- endif -%}
  {%- elif m.ergst == 0 -%}
    {#- Ook bij groen iets zeggen: een tegel die alleen "goed" meldt is een tegel
        die je na een week niet meer leest. -#}
    {%- set ns.reden = 'alles binnen de grenzen' -%}
  {%- elif m.ergste_k == 'co2' -%}
    {%- set ns.reden = 'CO₂ ' ~ (w | round | int) ~ ' ppm' -%}
    {%- set ns.advies = 'raam staat al open, even geduld' if ct.open > 0
                        else ('zet een raam open' if ct.totaal > 0 else 'ventileren') -%}
  {%- elif m.ergste_k == 'pm25' -%}
    {%- set ns.reden = 'fijnstof ' ~ g ~ ' µg/m³' -%}
    {%- set ns.advies = 'luchtreiniger aan, ramen dicht' -%}
  {%- elif m.ergste_k == 'temp' -%}
    {%- set koud = m.lijst | selectattr('k', 'eq', 'temp') | map(attribute='w') | first -%}
    {%- set te_koud = koud is not none and koud < 18 -%}
    {%- set ns.reden = ('koud, ' if te_koud else 'warm, ') ~ g ~ '°' -%}
    {%- if te_koud -%}
      {%- set ns.advies = 'verwarming of zonwering omhoog' -%}
    {%- elif buiten is not none and w is not none and buiten < (w - 1) -%}
      {%- set ns.advies = 'buiten is ' ~ (buiten | round | int) ~ '°, spuien kan' -%}
    {%- else -%}
      {%- set ns.advies = 'zonwering dicht houden' -%}
    {%- endif -%}
  {%- elif m.ergste_k == 'rv' -%}
    {%- set droog = w is not none and w < 40 -%}
    {%- set ns.reden = ('droge lucht, ' if droog else 'vochtig, ') ~ g ~ '%' -%}
    {%- set ns.advies = 'bevochtigen' if droog else 'ventileren, anders schimmelrisico' -%}
  {%- endif -%}

  {%- set uit.lijst = uit.lijst + [{
        'slug': k.slug, 'naam': k.naam, 'icoon': k.icoon,
        'verdieping': k.verdieping, 'soort': soort,
        'status': status, 'score': m.ergst,
        'reden': ns.reden, 'advies': ns.advies,
        'metingen': m.lijst, 'aantal_metingen': m.aantal,
        'beweging': {'gemeten': bw.aantal > 0, 'actief': bw.actief,
                     'minuten': (bw.jongste | round | int) if bw.jongste is not none else none},
        'contacten': {'gemeten': ct.totaal > 0, 'open': ct.open,
                      'totaal': ct.totaal, 'namen': ct.namen},
      }] -%}
{%- endfor -%}

{{- {'kamers': uit.lijst} | to_json -}}
{%- endmacro -%}

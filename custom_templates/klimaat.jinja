{#- ============================== HELPERS ================================= -#}

{#- Lijst met zoneslugs, voor automatiseringen die over alle zones lopen. -#}
{%- macro zone_lijst() -%}
{{- ZONES.keys() | list | to_json -}}
{%- endmacro -%}

{#- Volledige configuratie, voor dashboards en debugging. -#}
{%- macro zones_json() -%}
{{- ZONES | to_json -}}
{%- endmacro -%}

{#- Bij welke zone hoort deze cover? Lege string als hij niet beheerd wordt. -#}
{%- macro zone_van_cover(cover_id) -%}
{%- set ns = namespace(zone='') -%}
{%- for slug, z in ZONES.items() if z.cover == cover_id -%}
{%- set ns.zone = slug -%}
{%- endfor -%}
{{- ns.zone -}}
{%- endmacro -%}

{#- ========================= DE BESLISSING ZELF =========================== -#}
{#-
  Geeft JSON terug:
    advies     open | kier | dicht | rust
    positie    0-100, of -1 bij 'rust' (= niet bewegen)
    reden      leesbare uitleg voor het dashboard
    uitvoeren  mag de uitvoerder hier iets mee doen?
    blokkade   waarom niet, als uitvoeren false is
-#}
{%- macro advies(zone) -%}
{%- set z = ZONES[zone] -%}

{#- Alles eerst uitlezen. Home Assistant volgt alleen de entiteiten die tijdens
    het renderen echt gelezen zijn; staat een states() diep in een tak die nu
    niet gekozen wordt, dan ververst de sensor niet als die entiteit wijzigt. -#}
{%- set regime = states('input_select.klimaat_regime') | lower -%}
{%- set binnen = states(z.temp) | float(none) -%}
{%- set buiten = states('sensor.knmi_temperatuur') | float(none) -%}
{%- set warm = states('input_number.klimaat_kamer_warm') | float(22) -%}
{%- set hitte_vanaf = states('input_number.klimaat_hittedag_vanaf') | float(28) -%}
{%- set max_vandaag = states('input_number.klimaat_verwachte_max') | float(none) -%}
{%- set spui_delta = states('input_number.klimaat_spui_delta') | float(1) -%}
{%- set kier_pos = states('input_number.klimaat_kier_positie') | float(15) -%}
{%- set nachtspui = is_state('input_boolean.klimaat_nachtspui', 'on') -%}
{%- set actief = is_state('input_boolean.klimaatregie_actief', 'on') -%}
{#- Omgekeerd: 'aan' = handmatig. Een verse input_boolean staat uit, en dat
    moet 'gewoon meedoen' betekenen, niet 'zone stilzwijgend geblokkeerd'.
    Een boolean die er helemaal niet is, is iets anders dan een die uit staat:
    die valt in de bronnencontrole hierboven en zet de zone stil met een
    leesbare `blokkade`. Stilzwijgend is het dus nog steeds niet. -#}
{%- set zone_auto = not is_state('input_boolean.zonwering_handmatig_' ~ zone, 'on') -%}
{%- set override = is_state('timer.override_' ~ zone, 'active') -%}
{%- set elevatie = state_attr('sun.sun', 'elevation') | float(0) -%}
{#- ONBEKEND IS GEEN NEE
    `is_state(x, 'on')` en `is_state(x, 'home')` geven ook false als x niet
    bestaat of `unavailable` is. Daarmee verdwijnt het verschil tussen "nee" en
    "ik weet het even niet", en een advies dat op zo'n stille nee gebouwd is,
    wordt wel gewoon uitgevoerd.

    Dat is geen theorie. Bij elke YAML-reload haalt Home Assistant een deel van
    de entiteiten even weg en zet ze daarna terug; de recorder logt dat als een
    lege staat zonder attributen. Twee keer misgegaan op 2026-08-08:
      11:57  de gevelsensoren waren weg -> `zon_op` false -> advies voor
             kantoor sloeg om van dicht (0%) naar kier (15%), rolgordijnen
             gingen open en 39 seconden later weer dicht.
      12:10  `group.all_adults` was weg -> `thuis` false -> "niemand thuis op
             een warme dag" -> het keukenrolgordijn ging omlaag.
    De tweede sloop langs een guard die alleen naar de gevelsensoren keek. Dus
    nu in één keer alles wat bij een reload onder je handen vandaan kan
    verdwijnen: verderop zet dit `uitvoeren` op false, zodat de zonwering zijn
    stand vasthoudt tot de wereld er weer is. De `/15`-vangnettrigger van de
    uitvoerder pakt het daarna vanzelf op.

    WAT HIER BEWUST NIET IN STAAT
    De meetbronnen van buiten: `sensor.knmi_temperatuur`,
    `binary_sensor.knmi_waarschuwing`, `weather.knmi_thuis`, de neerslagsensor,
    `alarm_control_panel.alarmo`, `sun.sun` en de kamersensor `z.temp`. Die
    herladen niet mee met YAML, maar kunnen wél dagen achtereen wegblijven als
    een integratie stukgaat - en dan zou de zonwering permanent bevriezen.
    Erger nog: bevriezen blokkeert ook het beschermende kantje. Screens die bij
    storm naar binnen moeten, moeten dat kunnen blijven doen juist als het KNMI
    even niets zegt. Voor die bronnen is er de waakhond in
    packages/9 - Other/Watchdog.yaml. -#}
{%- set bron = namespace(mist='') -%}
{%- for e in ['input_select.klimaat_regime',
              'input_number.klimaat_kamer_warm',
              'input_number.klimaat_hittedag_vanaf',
              'input_number.klimaat_verwachte_max',
              'input_number.klimaat_spui_delta',
              'input_number.klimaat_kier_positie',
              'input_number.klimaat_screen_max_wind',
              'input_number.klimaat_screen_max_regen',
              'input_boolean.klimaat_nachtspui',
              'input_boolean.klimaat_wakker',
              'input_boolean.klimaatregie_actief',
              'input_boolean.zonwering_handmatig_' ~ zone,
              'timer.override_' ~ zone,
              'group.all_adults'] -%}
  {%- if bron.mist == '' and not has_value(e) -%}
    {%- set bron.mist = e -%}
  {%- endif -%}
{%- endfor -%}
{#- Een zone kan op meerdere gevels liggen; de zon telt zodra hij op één
    ervan staat. De lus leest beide sensoren per gevel altijd uit, zodat Home
    Assistant ze allemaal blijft volgen. -#}
{%- set zon = namespace(op=false, richting=false) -%}
{%- for g in z.gevels -%}
  {%- for e in ['binary_sensor.zon_op_' ~ g ~ 'gevel',
                'binary_sensor.zon_richting_' ~ g ~ 'gevel'] -%}
    {%- if bron.mist == '' and not has_value(e) -%}
      {%- set bron.mist = e -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if is_state('binary_sensor.zon_op_' ~ g ~ 'gevel', 'on') -%}
    {%- set zon.op = true -%}
  {%- endif -%}
  {%- if is_state('binary_sensor.zon_richting_' ~ g ~ 'gevel', 'on') -%}
    {%- set zon.richting = true -%}
  {%- endif -%}
{%- endfor -%}
{%- set zon_op = zon.op -%}
{%- set zon_richting = zon.richting -%}
{%- set bron_onbekend = bron.mist != '' -%}
{%- set gevel_txt = z.gevels | join('/') ~ 'gevel' -%}
{%- set thuis = is_state('group.all_adults', 'home') -%}
{#- Wanneer moet een screen in? Bij wind en vorst, niet bij hitte: een
    hitteplan-melding is juist een reden om ze te laten zakken.

    Twee bronnen. De windsnelheid uit de weersverwachting is de directe maat.
    Daarnaast de KNMI-waarschuwing, maar die is drie keer onbetrouwbaar: hij
    staat ook op 'on' als er niets is (vandaar de tekstcheck, net als in
    `knmi_weeralarm` in packages/9 - Other/Weather.yaml), hij gaat net zo goed
    af voor hitte of gladheid, én `description` is geen onderwerp maar een
    lopend verhaal over het weer van de komende dagen.

    Dat laatste ging op 3 augustus 2026 mis: het Nationaal Hitteplan stond aan
    en in die tekst zat "ook onweersbuien brengen plaatselijk enige
    verkoeling". Het woord 'onweer' zit in 'onweersbuien', dus een HITTE-
    waarschuwing telde als storm en de screens gingen in op een dag die naar de
    37 graden liep - precies het omgekeerde van wat je wil.

    Daarom kijken we naar `title` (het onderwerp van de waarschuwing) en pas
    als die leeg is naar de omschrijving. Een hitteplan sluiten we sowieso uit;
    harde wind wordt dan nog steeds gewoon door `wind_speed` afgevangen, en dat
    is de betrouwbare meting. -#}
{%- set alarm_titel = (state_attr('binary_sensor.knmi_waarschuwing', 'title') or '') | lower -%}
{%- set alarm_tekst = (state_attr('binary_sensor.knmi_waarschuwing', 'description') or '') | lower -%}
{%- set alarm_onderwerp = alarm_titel if alarm_titel != '' else alarm_tekst -%}
{%- set alarm_actief = is_state('binary_sensor.knmi_waarschuwing', 'on')
                       and 'geen waarschuwingen' not in alarm_tekst
                       and 'geen waarschuwingen' not in alarm_titel -%}
{%- set w = namespace(storm=false) -%}
{%- for woord in ['wind', 'storm', 'onweer', 'hagel', 'rukwind'] -%}
  {%- if woord in alarm_onderwerp -%}
    {%- set w.storm = true -%}
  {%- endif -%}
{%- endfor -%}
{#- Een hitteplan is nooit een reden om screens in te trekken, ook niet als er
    verderop in de tekst onweer wordt genoemd. -#}
{%- set hitteplan = 'hitteplan' in alarm_onderwerp or 'hitteplan' in alarm_tekst -%}
{%- set stormalarm = alarm_actief and w.storm and not hitteplan -%}
{%- set wind = state_attr('weather.knmi_thuis', 'wind_speed') | float(0) -%}
{%- set max_wind = states('input_number.klimaat_screen_max_wind') | float(45) -%}
{%- set te_hard = wind >= max_wind -%}
{#- Regen is de derde reden om een screen in te halen. Nat doek gaat schimmelen
    en opgerold nat doek nog harder; een zonnescherm hoort er niet in te hangen
    als het gaat regenen. Zonder deze regel liep dat alleen via een pushmelding
    uit de oude zonnescherm-automatisering (inmiddels verwijderd), die een tik
    op je telefoon nodig had - en als niemand keek, bleef het scherm dus uit staan.
    Een onbereikbare sensor telt als droog: dan is niets doen beter dan de hele
    dag alles binnenhalen. -#}
{%- set regen = states('sensor.neerslag_komende_30_minuten') | float(0) -%}
{%- set max_regen = states('input_number.klimaat_screen_max_regen') | float(0.1) -%}
{%- set nat = regen >= max_regen -%}
{%- set airco = z.get('airco') -%}
{#- De klok voor AIRCO_KIER_NA is `last_changed` van de airco zelf. Na een
    herstart van Home Assistant staat die klok van élke entiteit op nul, en dan
    zou een airco die al uren koelt vijf minuten lang niet meetellen: de
    uitvoerder trekt de rolluiken open (zijn startronde slaat de rustpauze over)
    en zet ze vijf minuten later weer terug. Draait HA zelf nog geen
    AIRCO_KIER_NA minuten, dan telt de huidige stand daarom meteen. Ontbreekt de
    starttijd, dan valt hij terug op de gewone meting - dat kost hooguit één
    onnodige beweging na een herstart. -#}
{%- set ha_start = states('sensor.home_assistant_gestart') | as_datetime -%}
{%- set net_gestart = ha_start is not none
                      and (now() - ha_start).total_seconds() < AIRCO_KIER_NA * 60 -%}
{%- set airco_obj = states[airco] if airco is not none else none -%}
{%- set airco_koelt = airco_obj is not none
                      and airco_obj.state in ['cool', 'dry']
                      and (net_gestart
                           or (now() - airco_obj.last_changed).total_seconds()
                              >= AIRCO_KIER_NA * 60) -%}

{%- set nacht = elevatie < -3 -%}
{%- set hittedag = max_vandaag is not none and max_vandaag >= hitte_vanaf -%}
{%- set te_warm = binnen is not none and binnen > warm -%}
{%- set heet = binnen is not none and binnen > (warm + 1) -%}
{%- set spui_ok = binnen is not none and buiten is not none and buiten <= (binnen - spui_delta) -%}
{%- set b_txt = (binnen | round(1) | string ~ '°') if binnen is not none else '?' -%}
{%- set u_txt = (buiten | round(1) | string ~ '°') if buiten is not none else '?' -%}
{%- set wakker = is_state('input_boolean.klimaat_wakker', 'on') -%}
{%- set in_stille_uren = now() >= today_at(STIL_VAN) or now() < today_at(STIL_TOT) -%}
{#- Na de stille uren, maar nog niemand wakker gemeld en het is nog vroeg. -#}
{%- set nog_slapen = not wakker and now() >= today_at(STIL_TOT)
                     and now() < today_at(WAKKER_UITERLIJK) -%}
{%- set stil_nu = z.stil and (in_stille_uren or nog_slapen) -%}
{#- Het slaapvenster van een kinderkamer loopt van `slaap_van` tot STIL_TOT,
    maar 07:00 is een klok en geen kind. Zolang het huis niet wakker is gemeld
    slaapt de kinderkamer dus door (`nog_slapen`, dus uiterlijk tot
    WAKKER_UITERLIJK). Zonder die verlenging viel de kier-uitzondering
    hieronder om 07:00 weer aan: op een warme ochtend gingen de kinderrolluiken
    dan alsnog op een kier terwijl er nog geslapen werd. Bij de badkamer en de
    ouderslaapkamer mag die spui-kier wél gewoon doorlopen. -#}
{%- set kind_slaapt = z.slaap == 'kind' and z.slaap_van is not none
                      and (now() >= today_at(z.slaap_van)
                           or now() < today_at(STIL_TOT)
                           or nog_slapen) -%}
{#- Het begin van de vroegste naar-bed-routine van vandaag; zie BEDTIJDEN
    bovenaan. De lus staat hier en niet in blok 5b, zodat Home Assistant deze
    helpers altijd volgt - ook voor de zones die er niets mee doen. -#}
{%- set bed = namespace(t=none) -%}
{%- for e in BEDTIJDEN -%}
  {%- set v = states(e) -%}
  {%- if ':' in v -%}
    {%- set t = today_at(v) -%}
    {%- if t >= today_at(BEDTIJD_VROEGST) and (bed.t is none or t < bed.t) -%}
      {%- set bed.t = t -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{#- De terugval geldt alleen als géén van de helpers een bruikbare avondtijd
    gaf; een latere bedtijd (weekend) hoort de rust juist op te schuiven. -#}
{%- set na_bedtijd = now() >= ((bed.t if bed.t is not none
                                else today_at(BEDTIJD_TERUGVAL))
                               - timedelta(minutes=BEDTIJD_MARGE)) -%}

{%- set ns = namespace(a='open', r='', spoed=false) -%}

{#- 1. Stille uren: alleen een kier om te spuien mag nog, verder niets.
      Behalve in een kinderkamer: die blijft tijdens het slaapvenster helemaal
      omlaag, ook op een warme nacht. Zonder die uitzondering ging het rolluik
      dat om 19:00 dicht was om 22:00 alsnog een kier open. -#}
{%- if stil_nu -%}
  {%- if regime == 'koelen' and nachtspui and spui_ok and heet
         and not kind_slaapt -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'warme nacht: kier om koelte binnen te laten (' ~ b_txt ~ ' binnen, ' ~ u_txt ~ ' buiten)' -%}
  {%- elif nog_slapen -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'nog niemand wakker gemeld, rolluik blijft staan' -%}
  {%- else -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'stille uren (' ~ STIL_VAN ~ '-' ~ STIL_TOT ~ '), niet bewegen' -%}
  {%- endif -%}

{#- 2. Kinderkamer in het slaapvenster: helemaal dicht, zonder uitzonderingen.
      Er stond hier een kier op hittedagen, maar in juni is het om 19:00 nog
      volop licht en daar blijven ze wakker van; donker weegt hier zwaarder dan
      die paar graden. Koelen gebeurt in deze kamers dus overdag (voor bedtijd)
      en met de airco, niet met een kier tijdens het slapen. -#}
{%- elif kind_slaapt -%}
  {%- set ns.a = 'dicht' -%}
  {%- set ns.r = 'slaapvenster kinderkamer' -%}

{#- 3. Nacht. -#}
{%- elif nacht -%}
  {%- if regime == 'koelen' and nachtspui and spui_ok -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'nachtspui: buiten ' ~ u_txt ~ ', binnen ' ~ b_txt -%}
  {%- else -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'donker: ' ~ ('isolatie' if regime == 'verwarmen' else 'dicht voor de nacht') -%}
  {%- endif -%}

{#- 4. Overdag, per regime. -#}
{%- elif regime == 'koelen' -%}
  {%- if zon_op -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'zon op de ' ~ gevel_txt ~ ', warmte buiten houden' -%}
  {%- elif not thuis and (hittedag or te_warm) -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'niemand thuis op een warme dag' -%}
  {%- elif hittedag and zon_richting -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'hittedag: preventief gedimd voordat de zon er komt' -%}
  {%- elif te_warm -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'kamer is ' ~ b_txt ~ ', licht temperen' -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'geen zon op de gevel en kamer koel genoeg (' ~ b_txt ~ ')' -%}
  {%- endif -%}

{%- elif regime == 'verwarmen' -%}
  {%- if zon_op and te_warm -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'zon, maar kamer is al ' ~ b_txt -%}
  {%- elif zon_op -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'zon op de ' ~ gevel_txt ~ ', gratis warmte binnenhalen' -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'daglicht' -%}
  {%- endif -%}

{%- else -%}
  {%- if zon_op and te_warm -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'zon en kamer is ' ~ b_txt -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'neutrale dag' -%}
  {%- endif -%}
{%- endif -%}

{#- 4b. Draait de airco om te koelen, dan de zon eruit houden: anders staat hij
       te betalen voor warmte die er zo weer in komt. Alleen bij 'open', want
       'dicht' is al beter en 'rust' moet rust blijven, en pas als hij het
       AIRCO_KIER_NA minuten volhoudt - zie daar waarom. -#}
{%- if airco_koelt and not nacht and ns.a == 'open' -%}
  {%- set ns.a = 'kier' -%}
  {%- set ns.r = 'airco koelt, zon eruit houden' -%}
{%- endif -%}

{#- 5. Een screen houdt STRALING tegen, geen warmte die er al is. Hij heeft dus
      alleen zin zolang de zon echt op de gevel staat.

      Hiervoor erfde een screen de uitkomst van de regime-tak hierboven, en die
      laat een rolluik ook zakken om andere redenen: kamer boven de comfort-
      grens, niemand thuis op een warme dag, airco die koelt. Voor een rolluik
      klopt dat (dat dempt ook licht), voor een screen niet. Gevolg: het screen
      bleef de hele warme avond omlaag terwijl de zon allang van de gevel af
      was. Daarom beslist een screen hier opnieuw, en overschrijft dat de tak
      hierboven. -#}
{%- if z.screen -%}
  {%- if nacht -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'donker: screen omhoog' -%}
  {%- elif regime == 'verwarmen' -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'zon is welkom vandaag, screen omhoog' -%}
  {%- elif zon_op -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'zon op de ' ~ gevel_txt ~ ', warmte buiten houden' -%}
  {%- elif hittedag and zon_richting -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'hittedag: screen alvast omlaag, de zon draait naar de ' ~ gevel_txt -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'geen zon op de ' ~ gevel_txt ~ ': een screen helpt alleen tegen zon' -%}
  {%- endif -%}
{%- endif -%}

{#- 5b. Binnenzonwering: de keukenrolgordijnen.

      Een rolgordijn hangt binnen. De zon is dan al door het glas heen en de
      warmte al in huis: het doek warmt op en geeft die warmte gewoon weer aan
      de keuken af. Hij haalt daarmee grofweg een derde van wat het screen
      ervoor doet, en kost wél het uitzicht en het daglicht in een keuken waar
      gewerkt wordt. Meelopen met het screen levert dus vooral een donkere
      keuken op.

      Hij springt daarom alleen bij als er echt iets te winnen valt:

        1. de zon staat op de gevel terwijl het screen ervoor NIET omlaag staat.
           Dat is de situatie na blok 6: wind, regen of vorst hebben de screens
           ingetrokken (en het geldt net zo goed bij handbediening of een
           storing). Dan is het rolgordijn de enige zonwering die er nog is.
        2. hittedag of een warme kamer terwijl er niemand thuis is. Donker kost
           dan niets.

      Staat het screen wél omlaag, dan blijft het rolgordijn omhoog: achter een
      screen blijft het glas koel en levert een tweede laag vrijwel niets meer.

      Buiten het dagvenster adviseert deze zone 'rust'. Dat venster loopt van
      het wakker-signaal tot de vroegste van deze twee:

        - het begin van de naar-bed-routine van de kinderen (zie BEDTIJDEN
          bovenaan). Dit ding is door het hele huis te horen en de kinderkamers
          liggen erboven.
        - een half uur voor zonsondergang (AVOND_ELEVATIE).

      Vanaf dat moment is het rolgordijn van `kitchen_covers_close` en
      `covers_lock_alarm_events`; die gaan over inkijk en niet over warmte, en
      daar hoort de klimaatregie niet doorheen te fietsen. Zou ze dat wel doen,
      dan trok de uitvoerder de rolgordijnen een kwartier later weer omhoog.
      In de zomer komt de bedtijd ruim eerst, in de winter de zonsondergang -
      en `kitchen_covers_close` gebruikt precies diezelfde twee momenten.
-#}
{%- if z.get('binnen') -%}
  {%- set screen_id = z.get('buitenzonwering') -%}
  {#- Alleen een volledig ingetrokken screen telt als "staat er niet". Onderweg
      naar beneden is de stand 'closing', en dan wachten we die beweging af. -#}
  {%- set screen_weg = screen_id is none or is_state(screen_id, 'open') -%}
  {%- set raam_id = z.get('raam') -%}
  {#- Alleen een aantoonbaar gesloten raam is veilig: 'unknown' of 'unavailable'
      telt hier als open, net zoals de oude `covers_morning_routine` het contact
      op 'off' moest zien staan voordat hij het rolgordijn liet zakken. -#}
  {%- set raam_dicht = raam_id is none or is_state(raam_id, 'off') -%}
  {#- Staat het alarm scherp, dan heeft `covers_lock_alarm_events` de
      rolgordijnen net dichtgetrokken tegen de inkijk. Alle armed_*-standen
      tellen; een onbereikbaar paneel telt als uit, want dan is niets doen
      beter dan de hele dag dicht blijven. -#}
  {%- set alarm_scherp = states('alarm_control_panel.alarmo').startswith('armed') -%}
  {%- if nog_slapen -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'nog niemand wakker gemeld, rolgordijn blijft staan' -%}
  {%- elif stil_nu or nacht or elevatie < AVOND_ELEVATIE -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'avond en nacht gaan over inkijk, niet over warmte' -%}
  {%- elif na_bedtijd -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'de kinderen gaan zo naar bed, rolgordijn is nu van de avondroutine' -%}
  {%- elif regime == 'verwarmen' -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'zon is welkom vandaag' -%}
  {%- elif zon_op and screen_weg -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'zon op de ' ~ gevel_txt ~ ' en het screen staat niet omlaag: rolgordijn neemt het over' -%}
  {%- elif (hittedag or te_warm) and not thuis -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'niemand thuis op een warme dag' -%}
  {%- elif zon_op -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'het screen vangt de zon al op, rolgordijn kan omhoog' -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'geen zon op de ' ~ gevel_txt ~ ': daglicht' -%}
  {%- endif -%}
  {#- Een leeg of afgesloten huis is van de inkijk-routine, niet van de
      klimaatregie. Zonder deze rem zou de uitvoerder de rolgordijnen die
      `covers_lock_alarm_events` net had dichtgetrokken op een milde dag binnen
      een kwartier weer omhoog halen - en dan ook nog eens vier uur
      handbediening aanzetten omdat hij zijn eigen tegenwerking als
      handbediening herkent. Omlaag mag wél gewoon: dat is dezelfde richting. -#}
  {%- if ns.a == 'open' and (alarm_scherp or not thuis) -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = ('alarm staat scherp' if alarm_scherp else 'niemand thuis')
                   ~ ': rolgordijn is dan van de inkijk-routine' -%}
  {%- endif -%}
  {%- if ns.a == 'dicht' and not raam_dicht -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'raam staat open, rolgordijn blijft omhoog' -%}
  {%- endif -%}
{%- endif -%}

{#- 6. Veiligheid gaat boven alles: een screen mag niet uitstaan bij harde
      wind, regen of vorst. Staat bewust als laatste, zodat het elke andere
      keuze overschrijft - ook een zone die normaal eerst toestemming vraagt
      gaat hierdoor zonder overleg naar binnen. -#}
{%- if z.screen and (te_hard or stormalarm or nat
                     or (buiten is not none and buiten < 4)) -%}
  {%- set ns.a = 'open' -%}
  {#- Spoed: dit is het enige advies dat niet mag wachten. De uitvoerder houdt
      sinds 18 augustus 2026 een kwartier rust tussen twee bewegingen van
      dezelfde cover (zie `mag_nu_bewegen` in packages/9 - Other/Klimaat
      Zonwering.yaml); nat doek of doek in de wind is precies het geval waarin
      die pauze niet hoort te gelden. -#}
  {%- set ns.spoed = true -%}
  {%- set ns.r = 'screen ingetrokken: ' ~ ('wind ' ~ wind | round | int ~ ' km/u' if te_hard
                  else ('stormwaarschuwing' if stormalarm
                  else ('regen op komst (' ~ regen | round(1) ~ ' mm)' if nat
                  else 'vorstgevaar'))) -%}
{%- endif -%}

{#- 7. Een cover zonder tussenstand kan geen kier. -#}
{%- if ns.a == 'kier' and not z.kier -%}
  {%- set ns.a = 'dicht' -%}
{%- endif -%}

{%- set positie_zon = {'open': 100, 'kier': kier_pos | int, 'dicht': 0, 'rust': -1}[ns.a] -%}
{#- Vertaling naar cover-termen, en dit is de enige plek waar dat gebeurt.
    Bij een omgekeerde cover (het zonnescherm: HA-stand `open` = uitgeschoven)
    is 'dicht voor de zon' juist een volledig open cover. Door dat hier te doen
    hoeven de uitvoerder en de handbediening-herkenning niets te weten van
    omgekeerde covers; die vergelijken gewoon `positie` met `current_position`.
    Controle op de veilige kant: bij storm zet regel 6 het advies op 'open'
    (= zon mag erdoor), wat hier 100 wordt en na omkering 0 - en 0 laat de
    uitvoerder `close_cover` sturen, oftewel het scherm trekt in. -#}
{%- set positie = (100 - positie_zon)
                  if (z.get('omgekeerd') and positie_zon >= 0)
                  else positie_zon -%}
{#- `not bron_onbekend`: het advies hierboven is bij een wegvallende bron niet
    fout maar wél ongefundeerd, en dan is stilstaan het juiste antwoord. Zie de
    toelichting bij de bronnenlijst. -#}
{%- set uitvoeren = actief and zone_auto and not override and positie >= 0
                    and not bron_onbekend -%}
{#- Zonwering die eerst toestemming vraagt: alleen het naar buiten gaan is een
    vraag. 'open' (binnenhalen, ook bij wind en vorst) blijft iets dat de
    uitvoerder gewoon zelf doet. `uitvoeren` blijft hierbij true - de zone doet
    mee, alleen loopt hij via de vraag-automatisering in plaats van via de
    uitvoerder. Die twee lezen allebei dit vlaggetje. -#}
{%- set vraagt = z.get('vraagt', false) and ns.a in ['dicht', 'kier'] -%}
{#- De ontbrekende bron staat mét entity-id in de blokkade: blijft een zone
    hangen, dan wil je kunnen zien wélke bron weg is. -#}
{%- set blokkade = 'handbediening actief' if override
                   else ('zone staat op handmatig' if not zone_auto
                   else ('klimaatregie staat uit' if not actief
                   else (('bron ontbreekt: ' ~ bron.mist) if bron_onbekend
                   else ('advies is rust' if positie < 0
                   else ('wacht op je akkoord' if vraagt else ''))))) -%}

{{- {'advies': ns.a,
     'positie': positie,
     'reden': ns.r,
     'uitvoeren': uitvoeren,
     'vraagt': vraagt,
     'spoed': ns.spoed,
     'blokkade': blokkade,
     'cover': z.cover,
     'naam': z.naam,
     'gevel': gevel_txt,
     'regime': regime} | to_json -}}
{%- endmacro -%}

{#- ======================= RAMEN-ADVIES (MELDINGEN) ======================= -#}
{#-
  Alles hieronder staat los van de beslistabel: `advies()` gebruikt het niet en
  het verandert er niets aan. Het hoort bij `packages/9 - Other/Temperature
  Control.yaml`, dat meldt wanneer ramen open- of dichtzetten loont.

  Waarom het hier staat en niet daar: datzelfde rekenwerk stond in vier
  automatiseringen steeds opnieuw overgetypt. De binnen/buiten-som vijf keer als
  trigger of conditie en nog eens drie keer in een meldingstekst, de lijst met
  wat er open staat drie keer, de cooldown vier keer. Eén drempel die je op vijf
  plekken moet bijwerken is er vier te veel; en de spui-vergelijking hoort per
  definitie hetzelfde te zijn als die in `advies()` (blok 3), anders adviseert
  het huis in stilte twee dingen tegelijk.

  Covers blijven het domein van de beslistabel: dit is puur meldingswerk.
-#}

{#- De drie temperatuurfeiten waar het ramen-advies op draait, in één keer
    uitgelezen. Binnen = de woonkamer-multisensor (de leefverdieping), buiten =
    KNMI - dezelfde bron als `advies()` hierboven.

    De afgeleide vlaggen zitten er meteen bij, want juist daar zat de kans op
    verschil: `spui_ok` is bewust exact dezelfde som als in blok 3, en
    `buiten_heter` is het spiegelbeeld ervan. Dat is geen symmetrie om de
    symmetrie: door aan beide kanten dezelfde dode zone te gebruiken kan de
    hittemelding nooit gelijktijdig met het ochtendadvies afgaan.

    Een onbereikbare sensor maakt alle drie de vlaggen `false`: een kapotte
    thermometer hoort een melding tegen te houden, niet uit te lokken. -#}
{%- macro buitenlucht() -%}
{%- set binnen = states('sensor.woonkamer_woonkamer_multisensor_temperatuur') | float(none) -%}
{%- set buiten = states('sensor.knmi_temperatuur') | float(none) -%}
{%- set delta = states('input_number.klimaat_spui_delta') | float(1) -%}
{%- set geldig = binnen is not none and buiten is not none -%}
{{- {'binnen': binnen,
     'buiten': buiten,
     'delta': delta,
     'geldig': geldig,
     'spui_ok': geldig and buiten <= binnen - delta,
     'buiten_warmer': geldig and buiten >= binnen,
     'buiten_heter': geldig and buiten >= binnen + delta} | to_json -}}
{%- endmacro -%}

{#- Wat staat er nu open, als leesbare namen? Gaat als JSON-lijst terug zodat de
    aanroeper zelf bepaalt hoe hij hem toont (`| from_json | join(', ')`).

    De openslaande tuindeuren zitten in `all_doors` en niet in `all_windows`, dus
    die moeten er los bij. Ze zijn een parameter en geen vaste bijlage, omdat het
    stookadvies ze bewust weglaat: daar kijkt de trigger ook alleen naar de
    ramengroep, en een tuindeur die in de winter even openstaat is meestal
    iemand die naar buiten loopt.

    De twee `expand()`-aanroepen staan bewust naast elkaar in plaats van als één
    aanroep met drie argumenten: `expand()` sorteert zijn uitkomst op entity_id,
    dus in één keer zouden de tuindeuren tussen de ramen door de melding in
    schuiven. Nu blijft het "eerst de ramen, dan de deuren". -#}
{%- macro open_ramen(tuindeuren=true) -%}
{%- set alles = expand('binary_sensor.all_windows')
                + (expand(['binary_sensor.woonkamer_openslaande_deuren_contact',
                           'binary_sensor.speelkamer_openslaande_deuren_contact'])
                   if tuindeuren else []) -%}
{{- alles | selectattr('state', 'eq', 'on') | map(attribute='name') | list | to_json -}}
{%- endmacro -%}

{#- Cooldown: is het lang genoeg geleden dat deze automatisering iets meldde?

    LET OP het eerste argument. Binnen een macro wijst `this` niet naar de
    automatisering maar naar het template zelf, dus de macro kán hem niet zelf
    opzoeken. Daarom geeft de aanroeper `this.attributes.last_triggered` mee:

        {% from 'klimaat.jinja' import cooldown_voorbij %}
        {{ cooldown_voorbij(this.attributes.last_triggered, 12) }}

    Geef je per ongeluk `this` mee in plaats van het attribuut, dan klapt de
    aftrekking en telt de conditie als niet-waar - de melding blijft dan uit in
    plaats van dat hij gaat spammen. Dat is de goede kant om fout te gaan.

    Wat de macro wél centraal houdt is de `is none`-tak. Zonder die tak loopt de
    aftrekking stuk zolang de automatisering nog nooit gedraaid heeft, en dan
    komt de allereerste melding na een verse installatie nooit. -#}
{%- macro cooldown_voorbij(laatst, uren) -%}
{{- laatst is none or now() - laatst > timedelta(hours=uren) -}}
{%- endmacro -%}

{#- ================= AIRCO - ACTIEF KOELEN EN BIJVERWARMEN ================ -#}
{#-
  De vijfde laag van de klimaatregie. De vier lagen hierboven verplaatsen
  warmte die er al is (zon buiten houden, koelte binnenlaten); deze laag maakt
  warmte of koude. Zelfde opzet: hier staat WAT een unit wil, het package
  `packages/9 - Other/Klimaat Airco.yaml` meet en voert uit.

  Gebruik:

      {% from 'klimaat.jinja' import airco_advies %}
      {{ (airco_advies('woonkamer') | trim | from_json).modus }}

  DE HELE KUNST IS NIET-PENDELEN. Een airco die om de vijf minuten aan- en
  uitgaat koelt niets, kost stroom en sloopt de compressor. Vijf remmen over
  elkaar, en ze hebben elk een eigen reden:

    1. Dode zone. Aan bij `kamer_warm + aan_delta` (23,5°), uit pas bij
       `kamer_warm - uit_delta` (21,5°). Twee graden ertussen. Eén drempel
       met een klein beetje hysterese is niet genoeg: de kamertemperatuur
       schommelt een halve graad op een zonnestraal.
    2. Minimale looptijd (`timer.airco_minimaal_aan_<unit>`). Eenmaal aan
       blijft hij een half uur aan, ook als de gemeten temperatuur eerder
       zakt - een airco die net begon heeft de kamer nog niet gekoeld, hij
       heeft de sensor gekoeld.
    3. Minimale rust (`timer.airco_rust_<unit>`). Na uitzetten twintig minuten
       niet opnieuw starten.
    4. De uitvoerder laat een unit met rust in de AIRCO_RUSTPAUZE minuten na
       zijn laatste standswijziging, precies zoals de rustpauze op de covers.
       Dat remt niet alleen ons eigen heen-en-weer, het geeft ook de
       handbediening-herkenning (vijf minuten) de tijd om te winnen van de
       uitvoerder (tien) als iemand de airco zelf aanzet.
    5. Het setpoint gaat één keer mee bij het aanzetten en wordt daarna niet
       meer bijgesteld. De inverter moduleert zelf; hem elke ronde een nieuw
       streefgetal geven is precies hoe je een warmtepomp aan het stuiteren
       krijgt.

  De veiligheidsredenen om uit te gaan (raam open, niemand thuis, storing)
  breken rem 2 en 4 wél af. Doorkoelen met een openstaand raam is geen comfort.
-#}

{#- Hoe lang de uitvoerder van een unit afblijft na diens laatste
    standswijziging. Langer dan de vijf minuten van de handbediening-herkenning,
    zodat die altijd eerst is: zet iemand de airco met de hand aan, dan staat er
    een override op vóórdat de uitvoerder hem terug kan zetten. Zonder die
    volgorde lijkt de knop niets te doen: de uitvoerder zet hem binnen vijf
    minuten weer terug, en dat is bij een apparaat dat zijn stand traag
    terugmeldt niet te zien aan wat er op het scherm staat. -#}
{%- set AIRCO_RUSTPAUZE = 10 -%}

{#- Een reistijd die niet meer ververst is geen reistijd. Blijft de sensor van
    een telefoon in het buitenland of met een lege accu op "twintig minuten"
    staan, dan zou het huis eeuwig staan voor te koelen voor iemand die niet
    komt. Ouder dan dit telt als onbruikbaar. -#}
{%- set AIRCO_REISTIJD_VERS = 30 -%}

{#- Zoveel graden moet een unit in een voortgangsvenster (de duur van
    `timer.airco_voortgang_<unit>`, 45 minuten) opgeschoven zijn om te tellen
    als "hij is aan het winnen". Haalt hij dat niet, dan draait hij ergens tegen
    op - een open raam zonder contact, een deur, een unit die het niet meer
    doet, of gewoon een doel dat niet te halen is - en dan is doordraaien 550 W
    voor niets. `automation.klimaat_airco_voortgang_bewaken` zet hem dan een
    paar uur stil en meldt de gemeten cijfers.

    0,3° op drie kwartier is bewust laag. Een airco die het echt wint doet in
    die tijd een halve tot anderhalve graad; alles daaronder is ruis op een
    sensor die op een tiende meet. -#}
{%- set AIRCO_VOORTGANG_MIN = 0.3 -%}

{#- Wie er "bijna thuis" kan zijn. Bewust alleen de volwassenen, net als
    `group.all_adults` in de beslistabel hierboven: hun telefoons zijn de
    betrouwbare bron en zij zijn degenen die 's middags aankomen. -#}
{%- set AIRCO_VOLWASSENEN = [
      ('person.robin_bohnen', 'sensor.robin_reistijd_naar_huis'),
      ('person.samantha_henkelman', 'sensor.samantha_reistijd_naar_huis')] -%}

{#-
  naam       label op het dashboard
  entiteit   de climate-entiteit
  temp       waar deze unit op regelt. De zolderunit blaast op de overloop en
             bedient de hele bovenverdieping, dus die regelt op het gemiddelde
             van de vijf kamersensoren (sensor.temperatuur_boven_gemiddeld uit
             packages/2 - Second Floor/Attic/AC.yaml) en niet op één kamer.
  ramen      raamcontacten van het gebied dat deze unit bedient. Een
             AANTOONBAAR open raam zet hem uit.
  band       verschuift de hele comfortband van deze unit, in graden. De
             zolderunit regelt op het gemiddelde van vijf kamers terwijl hij
             op de overloop hangt: achter een dichte slaapkamerdeur blaast hij
             niet. Op 20 augustus 2026 koelde hij vier uur op 18°/high en ging
             dat gemiddelde van 22,4 naar 22,2 - twee kamers werden zelfs
             warmer. Een doel dat op één kamer normaal is, is op dat gemiddelde
             dus onhaalbaar, en een onhaalbaar doel betekent een unit die nooit
             uit zichzelf stopt.
             `band` schuift daarom `kamer_warm` én `kamer_koud` voor deze unit
             op, zodat de dode zone even breed blijft (anders staat de
             aanzetgrens ineens een halve graad boven het doel en pendelt hij
             alsnog). Blijkt +1 te ruim of te krap, dan is dit het enige getal
             dat je hoeft te wijzigen.
  fan        ventilatorstand voor de automatische stand. Bewust niet 'high':
             dat is de stand van de handmatige "het is snikheet"-vraag, en die
             hoor je door het hele huis. De standen verschillen per merk
             (woonkamer 1-5, zolder quiet/low/medium/high).
  nacht      mag deze unit tijdens de stille uren uit zichzelf aanslaan?
             Allebei nee: de zolderunit hangt aan de overloop naast de
             slaapkamers, en de woonkamerunit koelt 's nachts een lege kamer.
  uit_script script dat het uitzetten doet in plaats van climate.turn_off.
             De zolderunit is regelmatig onbereikbaar en een kale turn_off
             faalt dan stil; script_attic_ac_off blijft het proberen.
-#}
{%- set AIRCOS = {
      'woonkamer': {
        'naam': 'Airco woonkamer',
        'entiteit': 'climate.airco_woonkamer',
        'temp': 'sensor.woonkamer_woonkamer_multisensor_temperatuur',
        'band': 0,
        'ramen': ['binary_sensor.keuken_raam_groot_contact',
                  'binary_sensor.keuken_raam_klein_contact',
                  'binary_sensor.woonkamer_openslaande_deuren_contact',
                  'binary_sensor.woonkamer_achterdeur_contact',
                  'binary_sensor.speelkamer_openslaande_deuren_contact'],
        'fan': '2',
        'nacht': false,
        'uit_script': none },
      'zolder': {
        'naam': 'Airco boven',
        'entiteit': 'climate.airco_zolder',
        'temp': 'sensor.temperatuur_boven_gemiddeld',
        'band': 1,
        'ramen': ['binary_sensor.badkamer_raam_contact',
                  'binary_sensor.kantoor_raam_links_contact',
                  'binary_sensor.kantoor_raam_rechts_contact',
                  'binary_sensor.slaapkamer_raam_links_contact',
                  'binary_sensor.slaapkamer_raam_rechts_contact',
                  'binary_sensor.slaapkamer_mini_raam_contact',
                  'binary_sensor.slaapkamer_mini_dakraam_contact',
                  'binary_sensor.slaapkamer_maxi_raam_links_contact',
                  'binary_sensor.slaapkamer_maxi_raam_rechts_contact'],
        'fan': 'medium',
        'nacht': false,
        'uit_script': 'script.script_attic_ac_off' },
    } -%}

{#- Lijst met units, voor automatiseringen die er allemaal langs lopen. -#}
{%- macro airco_lijst() -%}
{{- AIRCOS.keys() | list | to_json -}}
{%- endmacro -%}

{#- Volledige configuratie, voor dashboards en debugging. -#}
{%- macro aircos_json() -%}
{{- AIRCOS | to_json -}}
{%- endmacro -%}

{#- Bij welke unit hoort deze climate-entiteit? Leeg als hij niet beheerd wordt. -#}
{%- macro airco_van_entiteit(entity_id) -%}
{%- set ns = namespace(unit='') -%}
{%- for slug, u in AIRCOS.items() if u.entiteit == entity_id -%}
{%- set ns.unit = slug -%}
{%- endfor -%}
{{- ns.unit -}}
{%- endmacro -%}

{#- Is er een volwassene onderweg die binnen `minuten` thuis is?

    Niet `binary_sensor.iemand_onderweg_naar_huis`: die staat al aan zodra
    iemand het huis uit is, en dan koel je een uur voor niets. Hier telt de
    reistijd zelf, en alleen als de sensor nog ververst (AIRCO_REISTIJD_VERS)
    en de persoon aantoonbaar niet thuis is.

    `person.*` mag hier wél leidend zijn ondanks de trage router-tracker: een
    persoon die nog op `home` staat terwijl hij al weg is, levert hooguit een
    gemiste voorkoeling op - en `thuis` (group.all_adults) staat dan sowieso
    nog aan, dus de unit mag toch al draaien. Andersom kan het niet fout gaan.

    Geeft JSON: {'bijna': bool, 'wie': naam, 'minuten': n}. -#}
{%- macro bijna_thuis(minuten) -%}
{%- set ns = namespace(bijna=false, wie='', min=999) -%}
{%- for p, r in AIRCO_VOLWASSENEN -%}
  {%- set weg = states(p) not in ['home', 'unknown', 'unavailable'] -%}
  {%- set m = states(r) | float(-1) -%}
  {%- set obj = states[r] -%}
  {%- set vers = obj is not none
                 and (now() - obj.last_updated).total_seconds()
                     < AIRCO_REISTIJD_VERS * 60 -%}
  {%- if weg and vers and m >= 0 and m <= minuten and m < ns.min -%}
    {%- set ns.bijna = true -%}
    {%- set ns.min = m -%}
    {%- set ns.wie = state_attr(p, 'friendly_name') or p -%}
  {%- endif -%}
{%- endfor -%}
{{- {'bijna': ns.bijna,
     'wie': ns.wie,
     'minuten': (ns.min | round(0) | int) if ns.bijna else -1} | to_json -}}
{%- endmacro -%}

{#- Geeft JSON terug:
      modus      cool | heat | off | rust  (rust = niets sturen)
      doel       setpoint dat bij het aanzetten meegaat
      fan        ventilatorstand
      reden      leesbare uitleg voor het dashboard
      uitvoeren  mag de uitvoerder hier iets mee doen?
      spoed      mag dit de rustpauze van de uitvoerder overslaan?
      blokkade   waarom niet, als uitvoeren false is
-#}
{%- macro airco_advies(unit) -%}
{%- set u = AIRCOS[unit] -%}
{%- set e = u.entiteit -%}

{#- Alles eerst uitlezen; zie de toelichting bij `advies()` hierboven over
    waarom een template alleen volgt wat het echt gelezen heeft. -#}
{%- set regime = states('input_select.klimaat_regime') | lower -%}
{%- set binnen = states(u.temp) | float(none) -%}
{#- De comfortband van DEZE unit: de huisbrede grenzen plus zijn eigen
    verschuiving. Beide kanten schuiven mee, zodat de dode zone even breed
    blijft. Zie `band` in de tabel hierboven. -#}
{%- set band = u.get('band', 0) | float(0) -%}
{%- set warm = (states('input_number.klimaat_kamer_warm') | float(22)) + band -%}
{%- set koud = (states('input_number.klimaat_kamer_koud') | float(19)) + band -%}
{%- set aan_delta = states('input_number.klimaat_airco_aan_delta') | float(1.5) -%}
{%- set uit_delta = states('input_number.klimaat_airco_uit_delta') | float(0.5) -%}
{%- set voorkoel_min = states('input_number.klimaat_airco_voorkoelen_min') | float(20) -%}
{%- set actief = is_state('input_boolean.aircoregie_actief', 'on') -%}
{#- Omgekeerd, net als bij de zonwering: 'aan' = met de hand, dus niet meedoen.
    Een verse input_boolean staat uit en dat moet 'doet mee' betekenen. -#}
{%- set unit_auto = not is_state('input_boolean.airco_handmatig_' ~ unit, 'on') -%}
{%- set override = is_state('timer.airco_override_' ~ unit, 'active') -%}
{%- set storing = is_state('input_boolean.airco_storing_' ~ unit, 'on') -%}
{%- set min_aan = is_state('timer.airco_minimaal_aan_' ~ unit, 'active') -%}
{%- set rustpauze = is_state('timer.airco_rust_' ~ unit, 'active') -%}
{%- set kansloos = is_state('timer.airco_kansloos_' ~ unit, 'active') -%}
{%- set nu = states(e) -%}
{%- set draait = nu in ['cool', 'heat', 'dry', 'heat_cool', 'fan_only'] -%}

{#- Dezelfde bronnencontrole als bij de zonwering: een helper die tijdens een
    reload even weg is, mag geen beslissing dragen. De climate-entiteit staat er
    bewust NIET bij - die is bij de Intesis-cloud met enige regelmaat een paar
    minuten onbereikbaar, en dan moet de rest van de logica gewoon door kunnen
    lopen. De kamersensor ook niet: die vangen we hieronder apart af, omdat
    "temperatuur onbekend" een andere uitkomst hoort te geven ('rust') dan
    "helper weg" (blokkade op het dashboard). -#}
{%- set bron = namespace(mist='') -%}
{%- for x in ['input_select.klimaat_regime',
              'input_number.klimaat_kamer_warm',
              'input_number.klimaat_kamer_koud',
              'input_number.klimaat_airco_aan_delta',
              'input_number.klimaat_airco_uit_delta',
              'input_number.klimaat_airco_voorkoelen_min',
              'input_boolean.aircoregie_actief',
              'input_boolean.airco_handmatig_' ~ unit,
              'input_boolean.airco_storing_' ~ unit,
              'timer.airco_override_' ~ unit,
              'timer.airco_minimaal_aan_' ~ unit,
              'timer.airco_rust_' ~ unit,
              'timer.airco_kansloos_' ~ unit,
              'group.all_adults'] -%}
  {%- if bron.mist == '' and not has_value(x) -%}
    {%- set bron.mist = x -%}
  {%- endif -%}
{%- endfor -%}
{%- set bron_onbekend = bron.mist != '' -%}

{#- Het setpoint dat bij het aanzetten meegaat, en meteen de grens waarbij we
    weer uitzetten. Afgerond op de stap die de unit zelf kan (de zolderunit doet
    hele graden, de woonkamerunit halve) en geknepen binnen zijn eigen bereik -
    de zolderunit kan niet lager dan 18. Ontbreken die attributen omdat de unit
    net onbereikbaar is, dan gelden veilige terugvalwaarden. -#}
{%- set stap = state_attr(e, 'target_temp_step') | float(0.5) -%}
{%- set stap = stap if stap > 0 else 0.5 -%}
{%- set emin = state_attr(e, 'min_temp') | float(16) -%}
{%- set emax = state_attr(e, 'max_temp') | float(30) -%}
{#- Afronden naar de kant die de unit kán halen: koelen omhoog, verwarmen
    omlaag. Met 'common' rondt 22,5 op een unit die hele graden doet naar 22 af
    (Python rondt .5 naar even), en dan vraag je een halve graad méér dan
    bedoeld van precies de unit die zijn doel toch al niet haalt. Naar boven
    afronden kost hooguit een halve graad comfort en scheelt uren draaien. -#}
{%- set koel_doel = [[((warm - uit_delta) / stap) | round(0, 'ceil') * stap, emin] | max, emax] | min -%}
{%- set warm_doel = [[((koud + uit_delta) / stap) | round(0, 'floor') * stap, emin] | max, emax] | min -%}

{#- Wat wil de kamer? De dode zone zit tussen `te_warm` en `koel_klaar`. -#}
{%- set te_warm = binnen is not none and binnen >= warm + aan_delta -%}
{%- set koel_klaar = binnen is not none and binnen <= koel_doel -%}
{%- set te_koud = binnen is not none and binnen <= koud - aan_delta -%}
{%- set warm_klaar = binnen is not none and binnen >= warm_doel -%}
{%- set b_txt = (binnen | round(1) | string ~ '°') if binnen is not none else '?' -%}

{%- set thuis = is_state('group.all_adults', 'home') -%}
{%- set bt = bijna_thuis(voorkoel_min) | trim | from_json -%}

{#- Een AANTOONBAAR open raam blokkeert; een contact op unknown/unavailable
    niet. Dat is bewust andersom dan bij de rolgordijnen, en met reden: daar
    kost een verkeerde gok een gordijn dat tegen een raam aan rolt, hier kost
    hij een airco die de hele zomer niet meer aangaat omdat één batterij leeg
    is. Zo'n dood contact heeft een keer twee weken lang het keukenrolgordijn
    geblokkeerd zonder dat iemand zag waarom; daarom staat een onbereikbaar
    contact hieronder wél in de reden. -#}
{%- set raam = namespace(open='', kapot='') -%}
{%- for r in u.ramen -%}
  {%- set s = states(r) -%}
  {%- if s == 'on' and raam.open == '' -%}
    {%- set raam.open = state_attr(r, 'friendly_name') or r -%}
  {%- endif -%}
  {%- if s in ['unknown', 'unavailable'] and raam.kapot == '' -%}
    {%- set raam.kapot = r -%}
  {%- endif -%}
{%- endfor -%}

{%- set in_stille_uren = now() >= today_at(STIL_VAN) or now() < today_at(STIL_TOT) -%}
{%- set nacht_slot = in_stille_uren and not u.nacht -%}

{%- set ns = namespace(m='off', r='', doel=koel_doel, spoed=false) -%}

{#- 1. Veiligheid en verspilling. Deze redenen hebben de kamertemperatuur niet
      nodig, gaan vóór alles, en mogen de rustpauze van de uitvoerder en de
      minimale looptijd doorbreken: doorkoelen met een openstaand raam of in
      een leeg huis is geen comfort maar een rekening. -#}
{%- if raam.open != '' -%}
  {%- set ns.m = 'off' -%}
  {%- set ns.r = 'raam open (' ~ raam.open ~ ')' -%}
  {%- set ns.spoed = true -%}

{%- elif storing -%}
  {%- set ns.m = 'off' -%}
  {%- set ns.r = 'storing gemeld, automatisch starten staat uit' -%}
  {%- set ns.spoed = true -%}

{#- Hij heeft het net drie kwartier geprobeerd en kwam niet vooruit. Dan is er
    iets waar deze regeling niet tegenop kan (een openstaande deur, een raam
    zonder contact, een doel dat niet te halen is) en kost doordraaien alleen
    stroom. Even stoppen, en over een paar uur opnieuw kijken - dan staat de zon
    ergens anders of is dat raam dicht. Zie
    `automation.klimaat_airco_voortgang_bewaken`. -#}
{%- elif kansloos -%}
  {%- set ns.m = 'off' -%}
  {%- set ns.r = 'kwam niet vooruit, even gestopt (probeert later opnieuw)' -%}
  {%- set ns.spoed = true -%}

{%- elif not (thuis or bt.bijna) -%}
  {%- set ns.m = 'off' -%}
  {%- set ns.r = 'niemand thuis en niemand vlakbij' -%}
  {%- set ns.spoed = true -%}

{#- 2. Nachtrust. Uitgaan mag, aanslaan niet: de zolderunit hangt op de
      overloop naast de slaapkamers en de woonkamerunit zou een lege kamer
      koelen. Draait hij al, dan zet de "naar bed"-knop hem uit; hier is dat
      dus geen spoed maar gewoon het advies. -#}
{%- elif nacht_slot -%}
  {%- set ns.m = 'off' -%}
  {%- set ns.r = 'stille uren (' ~ STIL_VAN ~ '-' ~ STIL_TOT ~ '), niet uit zichzelf aan' -%}

{#- 3. Zonder kamertemperatuur valt er niets te vinden. Niet uitzetten (dat zou
      een draaiende airco op een kapotte batterij stilleggen), maar stilstaan. -#}
{%- elif binnen is none -%}
  {%- set ns.m = 'rust' -%}
  {%- set ns.r = 'kamertemperatuur onbekend (' ~ u.temp ~ ')' -%}

{#- 4. Koelen. Ook op een neutrale dag: het regime komt uit de verwachting van
      vanochtend, en een kamer van 23,5° is warm ongeacht wat het KNMI dacht.
      Alleen in het verwarmregime niet - dan is warmte het doel. -#}
{%- elif te_warm and regime != 'verwarmen' -%}
  {%- set ns.m = 'cool' -%}
  {%- set ns.doel = koel_doel -%}
  {%- set ns.r = 'kamer is ' ~ b_txt ~ ', koelen naar ' ~ koel_doel | round(1) ~ '°'
                 ~ ('' if thuis else
                    ' (' ~ bt.wie ~ ' is over ' ~ bt.minuten ~ ' min thuis)') -%}

{#- 5. Bijverwarmen. De cv doet het gewone werk; de airco springt bij als een
      ruimte er echt onder zakt. In het koelregime niet - dan is een koude
      ochtend geen reden om de dag warm te beginnen. -#}
{%- elif te_koud and regime != 'koelen' -%}
  {%- set ns.m = 'heat' -%}
  {%- set ns.doel = warm_doel -%}
  {%- set ns.r = 'kamer is ' ~ b_txt ~ ', bijverwarmen naar ' ~ warm_doel | round(1) ~ '°'
                 ~ ('' if thuis else
                    ' (' ~ bt.wie ~ ' is over ' ~ bt.minuten ~ ' min thuis)') -%}

{#- 6. Hij draait en het doel is nog niet gehaald: laten draaien. Dit is de tak
      die de dode zone maakt. Zonder hem zou hij bij 23,4° (net onder de
      aanzetgrens) meteen weer uitgaan en bij 23,5° weer aan. -#}
{%- elif draait and nu == 'cool' and not koel_klaar -%}
  {%- set ns.m = 'rust' -%}
  {%- set ns.r = 'koelt door, ' ~ b_txt ~ ' en het doel is ' ~ koel_doel | round(1) ~ '°' -%}

{%- elif draait and nu == 'heat' and not warm_klaar -%}
  {%- set ns.m = 'rust' -%}
  {%- set ns.r = 'verwarmt door, ' ~ b_txt ~ ' en het doel is ' ~ warm_doel | round(1) ~ '°' -%}

{#- 7. Niets te doen. -#}
{%- elif draait -%}
  {%- set ns.m = 'off' -%}
  {%- set ns.r = 'doel gehaald (' ~ b_txt ~ ')' -%}

{%- else -%}
  {%- set ns.m = 'off' -%}
  {%- set ns.r = 'kamer is ' ~ b_txt ~ ', binnen de comfortband' -%}
{%- endif -%}

{#- 8. Minimale looptijd. Een airco die vijf minuten geleden begon heeft de
      kamer niet gekoeld maar de sensor: de koude luchtstroom komt langs de
      thermometer voordat hij de muren heeft gehad. Zet je dan uit, dan kruipt
      de meting binnen tien minuten terug omhoog en begin je opnieuw. De
      veiligheidsredenen uit blok 1 komen hier niet, die zijn hierboven al
      afgehandeld en staan op spoed. -#}
{%- if min_aan and draait and ns.m == 'off' and not ns.spoed -%}
  {%- set ns.m = 'rust' -%}
  {%- set ns.r = 'minimale looptijd loopt nog (' ~ b_txt ~ ')' -%}
{%- endif -%}

{#- 9. Minimale rust na het uitzetten. Andersom hetzelfde verhaal: vlak na het
      uitschakelen loopt de meting juist op omdat de kamer zich herverdeelt. -#}
{%- if rustpauze and ns.m in ['cool', 'heat'] -%}
  {%- set ns.m = 'rust' -%}
  {%- set ns.r = 'rustpauze na uitschakelen (' ~ b_txt ~ ')' -%}
{%- endif -%}

{%- set uitvoeren = actief and unit_auto and not override and not bron_onbekend -%}
{%- set blokkade = 'handbediening actief' if override
                   else ('unit staat op handmatig' if not unit_auto
                   else ('aircoregie staat uit' if not actief
                   else (('bron ontbreekt: ' ~ bron.mist) if bron_onbekend
                   else ('advies is rust' if ns.m == 'rust' else '')))) -%}

{{- {'modus': ns.m,
     'doel': ns.doel,
     'fan': u.fan,
     'reden': ns.r ~ ('' if raam.kapot == '' else
                      ' - let op: raamcontact ' ~ raam.kapot ~ ' is onbereikbaar'),
     'uitvoeren': uitvoeren,
     'spoed': ns.spoed,
     'blokkade': blokkade,
     'entiteit': e,
     'temp': u.temp,
     'voortgang_min': AIRCO_VOORTGANG_MIN,
     'naam': u.naam,
     'uit_script': u.uit_script,
     'rustpauze_min': AIRCO_RUSTPAUZE,
     'regime': regime} | to_json -}}
{%- endmacro -%}

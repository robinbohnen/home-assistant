{#- ============================== HELPERS ================================= -#}

{#- Lijst met zoneslugs, voor automatiseringen die over alle zones lopen. -#}
{%- macro zone_lijst() -%}
{{- ZONES.keys() | list | to_json -}}
{%- endmacro -%}

{#- Volledige configuratie, voor dashboards en debugging. -#}
{%- macro zones_json() -%}
{{- ZONES | to_json -}}
{%- endmacro -%}

{#- Bij welke zone hoort deze cover? Lege string als hij niet beheerd wordt. -#}
{%- macro zone_van_cover(cover_id) -%}
{%- set ns = namespace(zone='') -%}
{%- for slug, z in ZONES.items() if z.cover == cover_id -%}
{%- set ns.zone = slug -%}
{%- endfor -%}
{{- ns.zone -}}
{%- endmacro -%}

{#- ========================= DE BESLISSING ZELF =========================== -#}
{#-
  Geeft JSON terug:
    advies     open | kier | dicht | rust
    positie    0-100, of -1 bij 'rust' (= niet bewegen)
    reden      leesbare uitleg voor het dashboard
    uitvoeren  mag de uitvoerder hier iets mee doen?
    blokkade   waarom niet, als uitvoeren false is
-#}
{%- macro advies(zone) -%}
{%- set z = ZONES[zone] -%}

{#- Alles eerst uitlezen. Home Assistant volgt alleen de entiteiten die tijdens
    het renderen echt gelezen zijn; staat een states() diep in een tak die nu
    niet gekozen wordt, dan ververst de sensor niet als die entiteit wijzigt. -#}
{%- set regime = states('input_select.klimaat_regime') | lower -%}
{%- set binnen = states(z.temp) | float(none) -%}
{%- set buiten = states('sensor.knmi_temperatuur') | float(none) -%}
{%- set warm = states('input_number.klimaat_kamer_warm') | float(22) -%}
{%- set hitte_vanaf = states('input_number.klimaat_hittedag_vanaf') | float(28) -%}
{%- set max_vandaag = states('input_number.klimaat_verwachte_max') | float(none) -%}
{%- set spui_delta = states('input_number.klimaat_spui_delta') | float(1) -%}
{%- set kier_pos = states('input_number.klimaat_kier_positie') | float(15) -%}
{%- set nachtspui = is_state('input_boolean.klimaat_nachtspui', 'on') -%}
{%- set actief = is_state('input_boolean.klimaatregie_actief', 'on') -%}
{#- Omgekeerd: 'aan' = handmatig. Een verse input_boolean staat uit, en dat
    moet 'gewoon meedoen' betekenen, niet 'zone stilzwijgend geblokkeerd'. -#}
{%- set zone_auto = not is_state('input_boolean.zonwering_handmatig_' ~ zone, 'on') -%}
{%- set override = is_state('timer.override_' ~ zone, 'active') -%}
{%- set elevatie = state_attr('sun.sun', 'elevation') | float(0) -%}
{#- Een zone kan op meerdere gevels liggen; de zon telt zodra hij op één
    ervan staat. De lus leest beide sensoren per gevel altijd uit, zodat Home
    Assistant ze allemaal blijft volgen. -#}
{%- set zon = namespace(op=false, richting=false) -%}
{%- for g in z.gevels -%}
  {%- if is_state('binary_sensor.zon_op_' ~ g ~ 'gevel', 'on') -%}
    {%- set zon.op = true -%}
  {%- endif -%}
  {%- if is_state('binary_sensor.zon_richting_' ~ g ~ 'gevel', 'on') -%}
    {%- set zon.richting = true -%}
  {%- endif -%}
{%- endfor -%}
{%- set zon_op = zon.op -%}
{%- set zon_richting = zon.richting -%}
{%- set gevel_txt = z.gevels | join('/') ~ 'gevel' -%}
{%- set thuis = is_state('group.all_adults', 'home') -%}
{#- Wanneer moet een screen in? Bij wind en vorst, niet bij hitte: een
    hitteplan-melding is juist een reden om ze te laten zakken.

    Twee bronnen. De windsnelheid uit de weersverwachting is de directe maat.
    Daarnaast de KNMI-waarschuwing, maar die is drie keer onbetrouwbaar: hij
    staat ook op 'on' als er niets is (vandaar de tekstcheck, net als in
    `knmi_weeralarm` in packages/9 - Other/Weather.yaml), hij gaat net zo goed
    af voor hitte of gladheid, én `description` is geen onderwerp maar een
    lopend verhaal over het weer van de komende dagen.

    Dat laatste ging op 3 augustus 2026 mis: het Nationaal Hitteplan stond aan
    en in die tekst zat "ook onweersbuien brengen plaatselijk enige
    verkoeling". Het woord 'onweer' zit in 'onweersbuien', dus een HITTE-
    waarschuwing telde als storm en de screens gingen in op een dag die naar de
    37 graden liep - precies het omgekeerde van wat je wil.

    Daarom kijken we naar `title` (het onderwerp van de waarschuwing) en pas
    als die leeg is naar de omschrijving. Een hitteplan sluiten we sowieso uit;
    harde wind wordt dan nog steeds gewoon door `wind_speed` afgevangen, en dat
    is de betrouwbare meting. -#}
{%- set alarm_titel = (state_attr('binary_sensor.knmi_waarschuwing', 'title') or '') | lower -%}
{%- set alarm_tekst = (state_attr('binary_sensor.knmi_waarschuwing', 'description') or '') | lower -%}
{%- set alarm_onderwerp = alarm_titel if alarm_titel != '' else alarm_tekst -%}
{%- set alarm_actief = is_state('binary_sensor.knmi_waarschuwing', 'on')
                       and 'geen waarschuwingen' not in alarm_tekst
                       and 'geen waarschuwingen' not in alarm_titel -%}
{%- set w = namespace(storm=false) -%}
{%- for woord in ['wind', 'storm', 'onweer', 'hagel', 'rukwind'] -%}
  {%- if woord in alarm_onderwerp -%}
    {%- set w.storm = true -%}
  {%- endif -%}
{%- endfor -%}
{#- Een hitteplan is nooit een reden om screens in te trekken, ook niet als er
    verderop in de tekst onweer wordt genoemd. -#}
{%- set hitteplan = 'hitteplan' in alarm_onderwerp or 'hitteplan' in alarm_tekst -%}
{%- set stormalarm = alarm_actief and w.storm and not hitteplan -%}
{%- set wind = state_attr('weather.knmi_thuis', 'wind_speed') | float(0) -%}
{%- set max_wind = states('input_number.klimaat_screen_max_wind') | float(45) -%}
{%- set te_hard = wind >= max_wind -%}
{#- Regen is de derde reden om een screen in te halen. Nat doek gaat schimmelen
    en opgerold nat doek nog harder; een zonnescherm hoort er niet in te hangen
    als het gaat regenen. Zonder deze regel liep dat alleen via de melding in
    packages/3 - Outside/Backyard/Sunscreen.yaml, die een tik op je telefoon
    nodig heeft - en als niemand kijkt, blijft het scherm dus uit staan.
    Een onbereikbare sensor telt als droog: dan is niets doen beter dan de hele
    dag alles binnenhalen. -#}
{%- set regen = states('sensor.neerslag_komende_30_minuten') | float(0) -%}
{%- set max_regen = states('input_number.klimaat_screen_max_regen') | float(0.1) -%}
{%- set nat = regen >= max_regen -%}
{%- set airco = z.get('airco') -%}
{%- set airco_koelt = airco is not none and states(airco) in ['cool', 'dry'] -%}

{%- set nacht = elevatie < -3 -%}
{%- set hittedag = max_vandaag is not none and max_vandaag >= hitte_vanaf -%}
{%- set te_warm = binnen is not none and binnen > warm -%}
{%- set heet = binnen is not none and binnen > (warm + 1) -%}
{%- set spui_ok = binnen is not none and buiten is not none and buiten <= (binnen - spui_delta) -%}
{%- set b_txt = (binnen | round(1) | string ~ '°') if binnen is not none else '?' -%}
{%- set u_txt = (buiten | round(1) | string ~ '°') if buiten is not none else '?' -%}
{%- set wakker = is_state('input_boolean.klimaat_wakker', 'on') -%}
{%- set in_stille_uren = now() >= today_at(STIL_VAN) or now() < today_at(STIL_TOT) -%}
{#- Na de stille uren, maar nog niemand wakker gemeld en het is nog vroeg. -#}
{%- set nog_slapen = not wakker and now() >= today_at(STIL_TOT)
                     and now() < today_at(WAKKER_UITERLIJK) -%}
{%- set stil_nu = z.stil and (in_stille_uren or nog_slapen) -%}
{#- Het slaapvenster van een kinderkamer loopt van `slaap_van` tot STIL_TOT,
    maar 07:00 is een klok en geen kind. Zolang het huis niet wakker is gemeld
    slaapt de kinderkamer dus door (`nog_slapen`, dus uiterlijk tot
    WAKKER_UITERLIJK). Zonder die verlenging viel de kier-uitzondering
    hieronder om 07:00 weer aan: op een warme ochtend gingen de kinderrolluiken
    dan alsnog op een kier terwijl er nog geslapen werd. Bij de badkamer en de
    ouderslaapkamer mag die spui-kier wél gewoon doorlopen. -#}
{%- set kind_slaapt = z.slaap == 'kind' and z.slaap_van is not none
                      and (now() >= today_at(z.slaap_van)
                           or now() < today_at(STIL_TOT)
                           or nog_slapen) -%}
{#- Het begin van de vroegste naar-bed-routine van vandaag; zie BEDTIJDEN
    bovenaan. De lus staat hier en niet in blok 5b, zodat Home Assistant deze
    helpers altijd volgt - ook voor de zones die er niets mee doen. -#}
{%- set bed = namespace(t=none) -%}
{%- for e in BEDTIJDEN -%}
  {%- set v = states(e) -%}
  {%- if ':' in v -%}
    {%- set t = today_at(v) -%}
    {%- if t >= today_at(BEDTIJD_VROEGST) and (bed.t is none or t < bed.t) -%}
      {%- set bed.t = t -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{#- De terugval geldt alleen als géén van de helpers een bruikbare avondtijd
    gaf; een latere bedtijd (weekend) hoort de rust juist op te schuiven. -#}
{%- set na_bedtijd = now() >= (bed.t if bed.t is not none
                               else today_at(BEDTIJD_TERUGVAL)) -%}

{%- set ns = namespace(a='open', r='') -%}

{#- 1. Stille uren: alleen een kier om te spuien mag nog, verder niets.
      Behalve in een kinderkamer: die blijft tijdens het slaapvenster helemaal
      omlaag, ook op een warme nacht. Zonder die uitzondering ging het rolluik
      dat om 19:00 dicht was om 22:00 alsnog een kier open. -#}
{%- if stil_nu -%}
  {%- if regime == 'koelen' and nachtspui and spui_ok and heet
         and not kind_slaapt -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'warme nacht: kier om koelte binnen te laten (' ~ b_txt ~ ' binnen, ' ~ u_txt ~ ' buiten)' -%}
  {%- elif nog_slapen -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'nog niemand wakker gemeld, rolluik blijft staan' -%}
  {%- else -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'stille uren (' ~ STIL_VAN ~ '-' ~ STIL_TOT ~ '), niet bewegen' -%}
  {%- endif -%}

{#- 2. Kinderkamer in het slaapvenster: helemaal dicht, zonder uitzonderingen.
      Er stond hier een kier op hittedagen, maar in juni is het om 19:00 nog
      volop licht en daar blijven ze wakker van; donker weegt hier zwaarder dan
      die paar graden. Koelen gebeurt in deze kamers dus overdag (voor bedtijd)
      en met de airco, niet met een kier tijdens het slapen. -#}
{%- elif kind_slaapt -%}
  {%- set ns.a = 'dicht' -%}
  {%- set ns.r = 'slaapvenster kinderkamer' -%}

{#- 3. Nacht. -#}
{%- elif nacht -%}
  {%- if regime == 'koelen' and nachtspui and spui_ok -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'nachtspui: buiten ' ~ u_txt ~ ', binnen ' ~ b_txt -%}
  {%- else -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'donker: ' ~ ('isolatie' if regime == 'verwarmen' else 'dicht voor de nacht') -%}
  {%- endif -%}

{#- 4. Overdag, per regime. -#}
{%- elif regime == 'koelen' -%}
  {%- if zon_op -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'zon op de ' ~ gevel_txt ~ ', warmte buiten houden' -%}
  {%- elif not thuis and (hittedag or te_warm) -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'niemand thuis op een warme dag' -%}
  {%- elif hittedag and zon_richting -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'hittedag: preventief gedimd voordat de zon er komt' -%}
  {%- elif te_warm -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'kamer is ' ~ b_txt ~ ', licht temperen' -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'geen zon op de gevel en kamer koel genoeg (' ~ b_txt ~ ')' -%}
  {%- endif -%}

{%- elif regime == 'verwarmen' -%}
  {%- if zon_op and te_warm -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'zon, maar kamer is al ' ~ b_txt -%}
  {%- elif zon_op -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'zon op de ' ~ gevel_txt ~ ', gratis warmte binnenhalen' -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'daglicht' -%}
  {%- endif -%}

{%- else -%}
  {%- if zon_op and te_warm -%}
    {%- set ns.a = 'kier' -%}
    {%- set ns.r = 'zon en kamer is ' ~ b_txt -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'neutrale dag' -%}
  {%- endif -%}
{%- endif -%}

{#- 4b. Draait de airco om te koelen, dan de zon eruit houden: anders staat hij
       te betalen voor warmte die er zo weer in komt. Alleen bij 'open', want
       'dicht' is al beter en 'rust' moet rust blijven. -#}
{%- if airco_koelt and not nacht and ns.a == 'open' -%}
  {%- set ns.a = 'kier' -%}
  {%- set ns.r = 'airco koelt, zon eruit houden' -%}
{%- endif -%}

{#- 5. Een screen houdt STRALING tegen, geen warmte die er al is. Hij heeft dus
      alleen zin zolang de zon echt op de gevel staat.

      Hiervoor erfde een screen de uitkomst van de regime-tak hierboven, en die
      laat een rolluik ook zakken om andere redenen: kamer boven de comfort-
      grens, niemand thuis op een warme dag, airco die koelt. Voor een rolluik
      klopt dat (dat dempt ook licht), voor een screen niet. Gevolg: het screen
      bleef de hele warme avond omlaag terwijl de zon allang van de gevel af
      was. Daarom beslist een screen hier opnieuw, en overschrijft dat de tak
      hierboven. -#}
{%- if z.screen -%}
  {%- if nacht -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'donker: screen omhoog' -%}
  {%- elif regime == 'verwarmen' -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'zon is welkom vandaag, screen omhoog' -%}
  {%- elif zon_op -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'zon op de ' ~ gevel_txt ~ ', warmte buiten houden' -%}
  {%- elif hittedag and zon_richting -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'hittedag: screen alvast omlaag, de zon draait naar de ' ~ gevel_txt -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'geen zon op de ' ~ gevel_txt ~ ': een screen helpt alleen tegen zon' -%}
  {%- endif -%}
{%- endif -%}

{#- 5b. Binnenzonwering: de keukenrolgordijnen.

      Een rolgordijn hangt binnen. De zon is dan al door het glas heen en de
      warmte al in huis: het doek warmt op en geeft die warmte gewoon weer aan
      de keuken af. Hij haalt daarmee grofweg een derde van wat het screen
      ervoor doet, en kost wél het uitzicht en het daglicht in een keuken waar
      gewerkt wordt. Meelopen met het screen levert dus vooral een donkere
      keuken op.

      Hij springt daarom alleen bij als er echt iets te winnen valt:

        1. de zon staat op de gevel terwijl het screen ervoor NIET omlaag staat.
           Dat is de situatie na blok 6: wind, regen of vorst hebben de screens
           ingetrokken (en het geldt net zo goed bij handbediening of een
           storing). Dan is het rolgordijn de enige zonwering die er nog is.
        2. hittedag of een warme kamer terwijl er niemand thuis is. Donker kost
           dan niets.

      Staat het screen wél omlaag, dan blijft het rolgordijn omhoog: achter een
      screen blijft het glas koel en levert een tweede laag vrijwel niets meer.

      Buiten het dagvenster adviseert deze zone 'rust'. Dat venster loopt van
      het wakker-signaal tot de vroegste van deze twee:

        - het begin van de naar-bed-routine van de kinderen (zie BEDTIJDEN
          bovenaan). Dit ding is door het hele huis te horen en de kinderkamers
          liggen erboven.
        - een half uur voor zonsondergang (AVOND_ELEVATIE).

      Vanaf dat moment is het rolgordijn van `kitchen_covers_close` en
      `covers_lock_alarm_events`; die gaan over inkijk en niet over warmte, en
      daar hoort de klimaatregie niet doorheen te fietsen. Zou ze dat wel doen,
      dan trok de uitvoerder de rolgordijnen een kwartier later weer omhoog.
      In de zomer komt de bedtijd ruim eerst, in de winter de zonsondergang -
      en `kitchen_covers_close` gebruikt precies diezelfde twee momenten.
-#}
{%- if z.get('binnen') -%}
  {%- set screen_id = z.get('buitenzonwering') -%}
  {#- Alleen een volledig ingetrokken screen telt als "staat er niet". Onderweg
      naar beneden is de stand 'closing', en dan wachten we die beweging af. -#}
  {%- set screen_weg = screen_id is none or is_state(screen_id, 'open') -%}
  {%- set raam_id = z.get('raam') -%}
  {#- Alleen een aantoonbaar gesloten raam is veilig: 'unknown' of 'unavailable'
      telt hier als open, net zoals de oude `covers_morning_routine` het contact
      op 'off' moest zien staan voordat hij het rolgordijn liet zakken. -#}
  {%- set raam_dicht = raam_id is none or is_state(raam_id, 'off') -%}
  {#- Staat het alarm scherp, dan heeft `covers_lock_alarm_events` de
      rolgordijnen net dichtgetrokken tegen de inkijk. Alle armed_*-standen
      tellen; een onbereikbaar paneel telt als uit, want dan is niets doen
      beter dan de hele dag dicht blijven. -#}
  {%- set alarm_scherp = states('alarm_control_panel.alarmo').startswith('armed') -%}
  {%- if nog_slapen -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'nog niemand wakker gemeld, rolgordijn blijft staan' -%}
  {%- elif stil_nu or nacht or elevatie < AVOND_ELEVATIE -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'avond en nacht gaan over inkijk, niet over warmte' -%}
  {%- elif na_bedtijd -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'de kinderen gaan naar bed, rolgordijn is nu van de avondroutine' -%}
  {%- elif regime == 'verwarmen' -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'zon is welkom vandaag' -%}
  {%- elif zon_op and screen_weg -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'zon op de ' ~ gevel_txt ~ ' en het screen staat niet omlaag: rolgordijn neemt het over' -%}
  {%- elif (hittedag or te_warm) and not thuis -%}
    {%- set ns.a = 'dicht' -%}
    {%- set ns.r = 'niemand thuis op een warme dag' -%}
  {%- elif zon_op -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'het screen vangt de zon al op, rolgordijn kan omhoog' -%}
  {%- else -%}
    {%- set ns.a = 'open' -%}
    {%- set ns.r = 'geen zon op de ' ~ gevel_txt ~ ': daglicht' -%}
  {%- endif -%}
  {#- Een leeg of afgesloten huis is van de inkijk-routine, niet van de
      klimaatregie. Zonder deze rem zou de uitvoerder de rolgordijnen die
      `covers_lock_alarm_events` net had dichtgetrokken op een milde dag binnen
      een kwartier weer omhoog halen - en dan ook nog eens vier uur
      handbediening aanzetten omdat hij zijn eigen tegenwerking als
      handbediening herkent. Omlaag mag wél gewoon: dat is dezelfde richting. -#}
  {%- if ns.a == 'open' and (alarm_scherp or not thuis) -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = ('alarm staat scherp' if alarm_scherp else 'niemand thuis')
                   ~ ': rolgordijn is dan van de inkijk-routine' -%}
  {%- endif -%}
  {%- if ns.a == 'dicht' and not raam_dicht -%}
    {%- set ns.a = 'rust' -%}
    {%- set ns.r = 'raam staat open, rolgordijn blijft omhoog' -%}
  {%- endif -%}
{%- endif -%}

{#- 6. Veiligheid gaat boven alles: een screen mag niet uitstaan bij harde
      wind, regen of vorst. Staat bewust als laatste, zodat het elke andere
      keuze overschrijft - ook een zone die normaal eerst toestemming vraagt
      gaat hierdoor zonder overleg naar binnen. -#}
{%- if z.screen and (te_hard or stormalarm or nat
                     or (buiten is not none and buiten < 4)) -%}
  {%- set ns.a = 'open' -%}
  {%- set ns.r = 'screen ingetrokken: ' ~ ('wind ' ~ wind | round | int ~ ' km/u' if te_hard
                  else ('stormwaarschuwing' if stormalarm
                  else ('regen op komst (' ~ regen | round(1) ~ ' mm)' if nat
                  else 'vorstgevaar'))) -%}
{%- endif -%}

{#- 7. Een cover zonder tussenstand kan geen kier. -#}
{%- if ns.a == 'kier' and not z.kier -%}
  {%- set ns.a = 'dicht' -%}
{%- endif -%}

{%- set positie_zon = {'open': 100, 'kier': kier_pos | int, 'dicht': 0, 'rust': -1}[ns.a] -%}
{#- Vertaling naar cover-termen, en dit is de enige plek waar dat gebeurt.
    Bij een omgekeerde cover (het zonnescherm: HA-stand `open` = uitgeschoven)
    is 'dicht voor de zon' juist een volledig open cover. Door dat hier te doen
    hoeven de uitvoerder en de handbediening-herkenning niets te weten van
    omgekeerde covers; die vergelijken gewoon `positie` met `current_position`.
    Controle op de veilige kant: bij storm zet regel 6 het advies op 'open'
    (= zon mag erdoor), wat hier 100 wordt en na omkering 0 - en 0 laat de
    uitvoerder `close_cover` sturen, oftewel het scherm trekt in. -#}
{%- set positie = (100 - positie_zon)
                  if (z.get('omgekeerd') and positie_zon >= 0)
                  else positie_zon -%}
{%- set uitvoeren = actief and zone_auto and not override and positie >= 0 -%}
{#- Zonwering die eerst toestemming vraagt: alleen het naar buiten gaan is een
    vraag. 'open' (binnenhalen, ook bij wind en vorst) blijft iets dat de
    uitvoerder gewoon zelf doet. `uitvoeren` blijft hierbij true - de zone doet
    mee, alleen loopt hij via de vraag-automatisering in plaats van via de
    uitvoerder. Die twee lezen allebei dit vlaggetje. -#}
{%- set vraagt = z.get('vraagt', false) and ns.a in ['dicht', 'kier'] -%}
{%- set blokkade = 'handbediening actief' if override
                   else ('zone staat op handmatig' if not zone_auto
                   else ('klimaatregie staat uit' if not actief
                   else ('advies is rust' if positie < 0
                   else ('wacht op je akkoord' if vraagt else '')))) -%}

{{- {'advies': ns.a,
     'positie': positie,
     'reden': ns.r,
     'uitvoeren': uitvoeren,
     'vraagt': vraagt,
     'blokkade': blokkade,
     'cover': z.cover,
     'naam': z.naam,
     'gevel': gevel_txt,
     'regime': regime} | to_json -}}
{%- endmacro -%}

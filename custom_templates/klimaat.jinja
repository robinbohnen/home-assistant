        'airco': 'climate.airco_zolder',
        'kier': true,
        'screen': false,
        'slaap': none,
        'slaap_van': none,
        'stil': false },
      'kantoor_rechts': {
        'naam': 'Kantoor rechts',
        'cover': 'cover.kantoor_rechts_low_speed',

        'airco': 'climate.airco_woonkamer',
        'kier': false,
        'screen': false,
        'binnen': true,
        'buitenzonwering': 'cover.covers_kitchen_screens',
        'raam': 'binary_sensor.keuken_raam_groot_contact',
        'slaap': none,
        'slaap_van': none,
        'stil': true },
      'keuken_rolgordijn_klein': {
        'naam': 'Keuken rolgordijn klein',
        'cover': 'cover.rollerblind_0002',
        'gevels': ['voor'],
        'temp': 'sensor.woonkamer_woonkamer_multisensor_temperatuur',
        'airco': 'climate.airco_woonkamer',
        'kier': false,
        'screen': false,
        'binnen': true,
        'buitenzonwering': 'cover.covers_kitchen_screens',
        'raam': 'binary_sensor.keuken_raam_klein_contact',
